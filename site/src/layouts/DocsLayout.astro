---
import Base from './Base.astro';
import { type Lang } from '../i18n';
import { withBase } from '../lib/data';
import {
  DOC_LANGS,
  DOC_SECTIONS,
  docPath,
  docSlug,
  sectionEntries,
  type DocEntry,
  type DocSection,
} from '../lib/docs';

interface Props {
  lang: Lang;
  section: DocSection;
  entry: DocEntry;
}
const { lang, section, entry } = Astro.props;
const entries = await sectionEntries(section);
const current = docSlug(entry, section);
const sectionTitle = DOC_SECTIONS[section];
const path = docPath(section, entry);
const link = (e: DocEntry) => withBase(`/${lang}${docPath(section, e)}`);
const idx = entries.findIndex((e) => docSlug(e, section) === current);
const prev = idx > 0 ? entries[idx - 1] : null;
const next = idx >= 0 && idx < entries.length - 1 ? entries[idx + 1] : null;
---

<Base lang={lang} title={`${entry.data.title} · ${sectionTitle}`} description={entry.data.description} path={path} availableLangs={DOC_LANGS} ogType="article" markdownPath={`/en${path}index.md`}>
  <div class="doc">
    <nav class="doc__side" aria-label={sectionTitle}>
      <p class="doc__section">{sectionTitle}</p>
      <ul>
        {entries.map((e) => {
          const slug = docSlug(e, section);
          return (
            <li class:list={{ 'doc__item--sub': slug.includes('/') }}>
              <a href={link(e)} aria-current={slug === current ? 'page' : undefined}
                >{e.data.label ?? e.data.title}</a>
            </li>
          );
        })}
      </ul>
    </nav>
    <article class="doc__article">
      <h1 id="doc-title">{entry.data.title}</h1>
      <slot />
      <nav class="doc__pager">
        {prev ? <a href={link(prev)}>← {prev.data.label ?? prev.data.title}</a> : <span />}
        {next ? <a href={link(next)}>{next.data.label ?? next.data.title} →</a> : <span />}
      </nav>
    </article>
  </div>
</Base>

<style>
  .doc__article :global(p a),
  .doc__article :global(li a),
  .doc__article :global(td a) { text-decoration: underline; text-underline-offset: 0.15em; }
  /* Docusaurus-classic (Infima) look for the tools/docs area only — the
     catalogue keeps the site's own pixel-museum styling. Values mirror the
     original font.tomchen.org theme: the site accent as primary, 95% code size,
     system-ui base stack, SFMono code stack. */
  .doc {
    --dx-font:
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      Ubuntu,
      Cantarell,
      'Noto Sans',
      'Helvetica Neue',
      Arial,
      sans-serif;
    --dx-mono: SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
    --dx-primary: var(--accent);
    --dx-primary-darker: color-mix(in srgb, var(--accent) 82%, black);
    --dx-text: #1c1e21;
    --dx-text-2: #606770;
    --dx-code-bg: #f6f7f8;
    --dx-code-border: rgba(0, 0, 0, 0.1);
    --dx-pre-bg: #f6f8fa;
    --dx-border: #dadde1;
    --dx-hover-bg: rgba(0, 0, 0, 0.05);
    --dx-stripe-bg: rgba(0, 0, 0, 0.03);
    font-family: var(--dx-font);
    color: var(--dx-text);
  }
  :global(:root[data-theme='dark']) .doc {
    --dx-text: #e3e3e3;
    --dx-text-2: #9aa0a6;
    --dx-code-bg: rgba(255, 255, 255, 0.09);
    --dx-code-border: rgba(255, 255, 255, 0.12);
    --dx-pre-bg: #2b2d31;
    --dx-border: #444950;
    --dx-hover-bg: rgba(255, 255, 255, 0.08);
    --dx-stripe-bg: rgba(255, 255, 255, 0.04);
  }

  .doc {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: var(--s6);
    align-items: start;
    line-height: 1.65;
  }
  @media (max-width: 800px) {
    .doc {
      grid-template-columns: 1fr;
    }
  }

  /* --- sidebar, Docusaurus menu style --- */
  .doc__side {
    position: sticky;
    top: var(--s4);
    border-right: 1px solid var(--dx-border);
    padding: var(--s2) var(--s3) var(--s2) 0;
    font-size: 0.875rem;
  }
  @media (max-width: 800px) {
    .doc__side {
      position: static;
      border-right: none;
      border-bottom: 1px solid var(--dx-border);
      padding: 0 0 var(--s3);
    }
  }
  .doc__section {
    margin: 0 0 var(--s2);
    padding: 0.375rem 0.75rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--dx-text);
  }
  .doc__side ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .doc__side li {
    margin: 0.125rem 0;
  }
  .doc__side a {
    display: block;
    padding: 0.375rem 0.75rem;
    border-radius: 0.25rem;
    color: var(--dx-text-2);
    text-decoration: none;
    line-height: 1.25;
  }
  .doc__side a:hover {
    background: var(--dx-hover-bg);
  }
  .doc__item--sub a {
    padding-left: 1.5rem;
  }
  .doc__side a[aria-current='page'] {
    color: var(--dx-primary);
    background: var(--dx-hover-bg);
    font-weight: 400;
  }

  /* --- article, Infima typography --- */
  .doc__article {
    min-width: 0;
    font-size: 1rem;
  }
  .doc__article :global(h1),
  .doc__article :global(h2),
  .doc__article :global(h3),
  .doc__article :global(h4) {
    font-family: var(--dx-font);
    font-weight: 700;
    line-height: 1.25;
    color: var(--dx-text);
  }
  .doc__article :global(h1) {
    font-size: 2.1rem;
    margin: 0 0 1.25rem;
  }
  .doc__article :global(h2) {
    font-size: 1.5rem;
    margin: 2.2rem 0 1rem;
    padding: 0;
    border: none;
  }
  .doc__article :global(h3) {
    font-size: 1.25rem;
    margin: 1.8rem 0 0.8rem;
  }
  .doc__article :global(h4) {
    font-size: 1rem;
  }
  .doc__article :global(a) {
    color: var(--dx-primary);
    text-decoration: none;
  }
  .doc__article :global(a:hover) {
    color: var(--dx-primary-darker);
    text-decoration: underline;
  }
  .doc__article :global(code) {
    font-family: var(--dx-mono);
    font-size: 95%;
    background: var(--dx-code-bg);
    border: 0.1rem solid var(--dx-code-border);
    border-radius: 0.25rem;
    padding: 0.1rem 0.3rem;
    vertical-align: baseline;
  }
  .doc__article :global(pre) {
    background: var(--dx-pre-bg);
    border: none;
    border-radius: 0.4rem;
    padding: 1rem;
    overflow-x: auto;
    font-family: var(--dx-mono);
    font-size: 0.875rem;
    line-height: 1.45;
  }
  .doc__article :global(pre code) {
    background: none;
    border: none;
    border-radius: 0;
    padding: 0;
    font-size: 100%;
  }
  .doc__article :global(blockquote) {
    margin: 0 0 1rem;
    padding: 0 1rem;
    border-left: 0.25rem solid var(--dx-border);
    color: var(--dx-text-2);
  }
  .doc__article :global(hr) {
    border: none;
    border-top: 1px solid var(--dx-border);
    margin: 2rem 0;
  }
  .doc__article :global(table) {
    border-collapse: collapse;
    display: block;
    overflow-x: auto;
    margin: 0 0 1rem;
  }
  .doc__article :global(th),
  .doc__article :global(td) {
    border: 1px solid var(--dx-border);
    padding: 0.4rem 0.75rem;
  }
  .doc__article :global(thead tr),
  .doc__article :global(tbody tr:nth-child(2n)) {
    background: var(--dx-stripe-bg);
  }
  .doc__article :global(img) {
    max-width: 100%;
  }
  .doc__article :global(kbd) {
    border: 1px solid var(--dx-border);
    border-bottom-width: 2px;
    border-radius: 3px;
    padding: 0 0.3em;
    font-size: 0.85em;
    background: var(--dx-code-bg);
    font-family: var(--dx-mono);
  }

  /* --- pager: Docusaurus pagination cards (the original theme thickens the
     border and fills gray on hover) --- */
  .doc__pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s4);
    margin-top: 3rem;
    font-family: var(--dx-font);
    font-size: 0.95rem;
  }
  .doc__pager :global(a) {
    display: block;
    border: 0.15rem solid var(--dx-border);
    border-radius: 0.4rem;
    padding: 0.8rem 1rem;
    color: var(--dx-primary);
    font-weight: 700;
    text-decoration: none;
    line-height: 1.3;
  }
  .doc__pager :global(a:hover) {
    background: var(--dx-hover-bg);
    border-color: var(--dx-primary);
    text-decoration: none; /* the article's link-hover underline doesn't fit a card */
  }
  .doc__pager :global(a:last-child:not(:first-child)) {
    text-align: right;
  }
</style>
