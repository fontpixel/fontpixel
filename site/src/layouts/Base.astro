    <script>
      import { revealPercent, revealRadius, transformOffset } from '../lib/viewtransition';
      import { DEFAULT_PALETTE, type Mode, type Palette } from '../lib/palettes';

      const root = document.documentElement;
      const trigger = document.querySelector<HTMLElement>('[data-testid="theme-toggle"]');
      const themeMenu = document.querySelector<HTMLElement>('[data-testid="theme-menu"]');
      const swatches = [...document.querySelectorAll<HTMLElement>('[data-theme-palette]')];
      const systemItem = document.querySelector<HTMLElement>('[data-theme-system]');
      const systemDark = matchMedia('(prefers-color-scheme: dark)');
      const systemMode = (): Mode => (systemDark.matches ? 'dark' : 'light');

      const stored = (key: string) => {
        try {
          return localStorage.getItem(key);
        } catch {
          return null; /* e.g. in private browsing mode */
        }
      };
      const store = (key: string, value: string | null) => {
        try {
          if (value === null) localStorage.removeItem(key);
          else localStorage.setItem(key, value);
        } catch {
          /* ignore, e.g. in private browsing mode */
        }
      };

      /** Tick the theme on show, and "follow system" while no mode was picked. */
      const sync = () => {
        for (const sw of swatches) {
          const on =
            sw.dataset.themePalette === root.dataset.palette && sw.dataset.themeMode === root.dataset.theme;
          sw.setAttribute('aria-checked', String(on));
        }
        systemItem?.setAttribute('aria-checked', String(stored('opf-theme') === null));
      };

      /** Switch to a theme, the new one spreading out from `origin` in a growing circle. */
      const switchTheme = (palette: Palette, mode: Mode, origin: HTMLElement) => {
        const apply = () => {
          root.dataset.theme = mode;
          root.dataset.palette = palette;
          sync();
        };
        if (root.dataset.theme === mode && root.dataset.palette === palette) {
          sync();
          return;
        }
        if (
          typeof document.startViewTransition !== 'function' ||
          matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          apply();
          return;
        }
        // The circle is a clip-path on ::view-transition-new(root). Two things keep
        // its centre on the origin:
        // - That box is not always the viewport: on phones it also covers the area
        //   under the browser's toolbars. A 1px marker named `theme-origin` sits on the
        //   origin, and its group's transform says where that is within the box.
        // - On a 2x display, Chrome (152, Linux) paints px lengths in that clip-path at
        //   half size on screen, putting the centre halfway to the top-left corner. DevTools
        //   screenshots don't show it. Percentages of the box are unaffected.
        const r = origin.getBoundingClientRect();
        const x = r.left + r.width / 2;
        const y = r.top + r.height / 2;
        const marker = document.createElement('div');
        marker.className = 'theme-vt-origin';
        marker.style.left = `${x}px`;
        marker.style.top = `${y}px`;
        document.body.append(marker);
        root.classList.add('theme-vt');
        const vt = document.startViewTransition(apply);
        vt.ready
          .then(() => {
            const box = getComputedStyle(root, '::view-transition');
            const w = parseFloat(box.width) || innerWidth;
            const h = parseFloat(box.height) || innerHeight;
            const [cx, cy] =
              transformOffset(getComputedStyle(root, '::view-transition-group(theme-origin)').transform) ??
              [x, y];
            const at = `at ${(cx / w) * 100}% ${(cy / h) * 100}%`;
            const radius = revealPercent(revealRadius(cx, cy, w, h), w, h);
            root.animate(
              { clipPath: [`circle(0% ${at})`, `circle(${radius}% ${at})`] },
              { duration: 520, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', pseudoElement: '::view-transition-new(root)' },
            );
          })
          .catch(() => {
            /* skipped transition: the theme is applied regardless */
          });
        vt.finished.finally(() => {
          marker.remove();
          root.classList.remove('theme-vt');
        });
      };

      /** Close the menu after a pick; a keyboard pick hands focus back to the icon. */
      const done = (event: MouseEvent) => {
        themeMenu?.querySelector<HTMLElement>('[data-menu-popup]')?.dispatchEvent(
          new KeyboardEvent('keydown', { key: 'Escape', bubbles: true }),
        );
        if (event.detail !== 0) trigger?.blur();
      };

      for (const sw of swatches) {
        sw.addEventListener('click', (event) => {
          const palette = sw.dataset.themePalette as Palette;
          const mode = sw.dataset.themeMode as Mode;
          // While following the system, a swatch in the system's mode only changes
          // the palette; the other mode is a choice of mode and ends the following.
          const following = stored('opf-theme') === null && mode === systemMode();
          if (!following) store('opf-theme', mode);
          store('opf-palette', palette === DEFAULT_PALETTE ? null : palette);
          switchTheme(palette, mode, sw);
          done(event);
        });
      }
      systemItem?.addEventListener('click', (event) => {
        store('opf-theme', null);
        switchTheme((root.dataset.palette as Palette) ?? DEFAULT_PALETTE, systemMode(), trigger ?? systemItem);
        done(event);
      });
      // Until a mode is picked, the site keeps following the system as it changes.
      systemDark.addEventListener('change', () => {
        if (stored('opf-theme') === null && trigger) {
          switchTheme((root.dataset.palette as Palette) ?? DEFAULT_PALETTE, systemMode(), trigger);
        }
      });
      sync();
    </script>

    <style>
      .skip-links {
        position: absolute;
        left: var(--s3);
        top: 0;
        z-index: 100;
        display: flex;
        flex-wrap: wrap;
        gap: var(--s1);
        max-width: calc(100% - 2 * var(--s3));
        transform: translateY(-100%);
        transition: transform 0.15s;
      }
      .skip-link {
        padding: var(--s2) var(--s3);
        background: var(--surface);
        border: 1px solid var(--line);
      }
      .skip-links:focus-within {
        transform: translateY(var(--s2));
      }
      /* Interactive header items carry their own padding so the hit areas are
         generous; the row's padding shrinks by the same amount to keep the
         visual height, and the two edge items pull back with negative margins
         so text still aligns with the container. */
      .site-header__row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--s4);
        flex-wrap: wrap;
        padding-top: var(--s2);
        padding-bottom: var(--s1);
      }
      .site-brand {
        display: flex;
        align-items: baseline;
        gap: var(--s2);
        min-width: 0;
        padding: var(--s2);
        margin-left: calc(-1 * var(--s2));
      }
      .site-brand__name {
        font-size: 1.35rem;
        font-weight: 700;
        letter-spacing: 0.02em;
      }
      /* Pixel web font: the font size must be an integer multiple of the native pixel
         size (inline style gives 2×); synthetic bold and letter spacing would both
         ruin the pixel grid */
      .site-brand__name--pix {
        font-family: 'FontPixel Brand', system-ui, sans-serif;
        font-weight: 400;
        letter-spacing: 0;
        line-height: 1;
        font-synthesis: none;
      }
      @media (max-width: 1100px) {
        }
      .site-nav {
        display: flex;
        align-items: center;
        flex-wrap: wrap; /* the four items don't fit at 300px wide, so allow wrapping */
        gap: var(--s1) 0; /* the items' own padding provides the visual spacing */
        font-size: 0.9rem;
        color: var(--ink-2);
      }
      .site-nav > a {
        padding: var(--s2);
      }
      .navmenu {
        position: relative;
      }
      .navmenu__trigger {
        cursor: pointer;
        display: block;
        padding: var(--s2);
        border: 0;
        color: inherit;
        font-size: 1rem;
        background: transparent;
      }
      .navmenu ul {
        position: absolute;
        left: 0;
        top: 100%; /* flush under the padded trigger */
        z-index: 20;
        margin: 0;
        padding: var(--s2) 0;
        list-style: none;
        background: var(--surface);
        border: 1px solid var(--line);
        min-width: 8rem;
        max-width: calc(100vw - 16px);
        overflow-y: visible;
      }
      /* Pops out like the font.tomchen.org navbar dropdowns (Infima's
         .dropdown__menu: scale 0.8 → 1 with a slight overshoot, 200ms), and
         fades back out: `hidden` only takes effect once the exit has run. */
      .navmenu ul {
        transform-origin: top center;
        transition:
          opacity 0.2s cubic-bezier(0.24, 0.22, 0.015, 1.56),
          transform 0.2s cubic-bezier(0.24, 0.22, 0.015, 1.56),
          display 0.2s allow-discrete;
      }
      .navmenu ul[hidden] {
        display: none;
        opacity: 0;
        transform: scale(0.8);
        pointer-events: none;
      }
      @starting-style {
        .navmenu ul:not([hidden]) {
          opacity: 0;
          transform: scale(0.8);
        }
      }
      .navmenu[data-menu-side='top'] ul {
        transform-origin: bottom center;
      }
      @media (prefers-reduced-motion: reduce) {
        .navmenu ul {
          transition: none;
        }
      }
      .navmenu[data-menu-clipped] ul {
        overflow-y: auto;
      }
      .toolsmenu ul,
      .githubmenu ul {
        min-width: 14rem;
      }
      /* Theme menu: a palette per row — its name, then its light and dark theme
         as swatches in the theme's own paper and accent. The theme on show
         gets a ring in its accent. */
      .thememenu ul {
        padding: var(--s2);
      }
      .thememenu__row {
        display: grid;
        grid-template-columns: 1fr auto auto;
        align-items: center;
        gap: var(--s2);
        padding: 3px 0;
      }
      .thememenu__name {
        padding: 0 var(--s3) 0 var(--s1);
        font-size: 0.85rem;
        color: var(--ink-2);
        white-space: nowrap;
      }
      .thememenu__swatch {
        display: grid;
        place-items: center;
        width: 2.5rem;
        height: 2rem;
        padding: 0;
        border: 1px solid color-mix(in srgb, var(--sw-accent) 30%, var(--line));
        border-radius: 4px;
        background: var(--sw-paper);
        color: var(--sw-accent);
        cursor: pointer;
        transition: transform 0.12s ease, box-shadow 0.12s ease;
      }
      .thememenu__swatch svg {
        width: 1.2rem;
        height: 1.2rem;
      }
      .thememenu__swatch:hover {
        transform: translateY(-1px);
        border-color: var(--sw-accent);
      }
      .thememenu__swatch[aria-checked='true'] {
        box-shadow:
          0 0 0 2px var(--surface),
          0 0 0 4px var(--sw-accent);
      }
      .thememenu__swatch:focus-visible {
        outline-offset: 5px;
      }
      .thememenu__system {
        margin-top: var(--s2);
        padding-top: var(--s2);
        border-top: 1px solid var(--line);
      }
      .thememenu__system button {
        display: flex;
        align-items: center;
        gap: var(--s2);
        width: 100%;
        padding: var(--s1) var(--s1);
        border: 0;
        background: transparent;
        color: var(--ink-2);
        font: inherit;
        font-size: 0.85rem;
        text-align: left;
        white-space: nowrap;
        cursor: pointer;
      }
      .thememenu__system button:hover {
        color: var(--accent);
        background: var(--accent-soft);
      }
      .thememenu__check {
        flex: none;
        width: 1rem;
        height: 1rem;
        color: var(--accent);
      }
      [aria-checked='false'] > .thememenu__check {
        visibility: hidden;
      }
      @media (prefers-reduced-motion: reduce) {
        .thememenu__swatch {
          transition: none;
        }
      }
      .navmenu li a {
        display: block;
        padding: var(--s1) var(--s3);
        white-space: nowrap;
      }
      .navmenu li a:hover {
        background: var(--accent-soft);
      }
      /* There's a visual gap between the trigger and menu — the pointer leaves .navmenu
         crossing it, triggering a close. Fill it with a transparent area — placed right
         under the trigger only, so it doesn't cover the nav links to the left when expanded. */
      .navmenu[data-open][data-menu-side='bottom']::after {
        content: '';
        position: absolute;
        inset: 100% 0 auto 0;
        height: 0.8em;
      }
      .icon {
        width: 1.5em;
        height: 1.5em;
        display: block;
      }
      /* The button shows the icon for the "current" theme: sun in light mode, moon in dark mode */
      :root[data-theme='dark'] .icon--sun,
      :root:not([data-theme='dark']) .icon--moon {
        display: none;
      }
      .theme-toggle {
        border: none;
        padding: var(--s2);
        font-size: 1rem;
        color: var(--ink-2);
      }
      .nav-icon {
        display: flex;
        align-items: center;
        padding: var(--s2);
        color: var(--ink-2);
      }
      .site-nav > :last-child {
        margin-right: calc(-1 * var(--s2)); /* right edge stays aligned with the container */
      }
      .navmenu__trigger:is(:hover, :focus-visible),
      .theme-toggle:is(:hover, :focus-visible),
      .site-nav a:is(:hover, :focus-visible) {
        color: var(--accent);
        background-color: var(--accent-soft);
      }
      .site-main {
        min-height: 70vh;
        padding-top: var(--s5);
        padding-bottom: var(--s7);
      }
      .container--wide {
        max-width: none;
        padding-left: var(--s4);
        padding-right: var(--s4);
      }
      .site-main--wide {
        max-width: none;
        padding: 0;
      }
      .site-footer__inner {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
        gap: var(--s3) var(--s6);
        font-size: 0.8rem;
        color: var(--ink-3);
        padding-top: var(--s4);
        padding-bottom: var(--s5);
      }
      .site-footer__name {
        color: var(--ink-2);
        font-weight: 700;
      }
      .site-footer__inner p {
        margin: 0 0 var(--s1);
      }
      .site-footer__links {
        display: flex;
        flex-direction: column;
        gap: var(--s1);
        align-items: flex-start;
      }
      @media (max-width: 640px) {
        .site-footer__inner {
          grid-template-columns: 1fr;
        }
      }
      @media (max-width: 640px) {
        .site-header__row {
          flex-direction: column;
          gap: var(--s2);
        }
      }
    </style>
  </body>
