---
import '../styles/tokens.css';
import { readFileSync } from 'node:fs';
import { LANGS, LANG_NAMES, LANG_TAGS, t, otherLang, type Lang } from '../i18n';
import { withBase } from '../lib/data';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Path without the language prefix, e.g. "/fonts/galmuri/" — used for hreflang and language switching */
  path: string;
  ogImage?: string;
  /** Language versions this page actually exists in; defaults to all. English-only
   * docs pages pass ['en'] — the language menu and hreflang only list these. */
  availableLangs?: Lang[];
}

const REPO_URL = 'https://github.com/pixelfont/open-pixel-fonts';

const { lang, title, description, path, ogImage, availableLangs } = Astro.props;
const langs = availableLangs ?? LANGS;
const otherLangs = langs.filter((l) => l !== lang);
const s = t(lang);
const other = otherLang(lang);
// canonical / og:url / hreflang must be absolute URLs — search engines don't honor relative paths.
// Astro.site comes from `site` in astro.config (CI injects OPF_SITE).
const abs = (p: string) => new URL(withBase(p), Astro.site).href;
const canonical = abs(`/${lang}${path}`);
// A single-language page emits no alternates — hreflang must come in mutually
// referencing groups; one lone entry is meaningless.
const alternates =
  langs.length > 1 ? langs.map((l) => ({ tag: LANG_TAGS[l], href: abs(`/${l}${path}`) })) : [];
const xDefaultLang = langs.includes('zh' as Lang) ? 'zh' : langs[0];
const isHome = path === '/';

// The site name uses a pixel web font subsetted at build time (brand.woff2, a few KB,
// cached once site-wide), replacing the old per-page canvas rendering. brand is null
// when data hasn't been built, falling back to the system font.
let brand: { file: string; px: number; family: string } | null = null;
try {
  brand = JSON.parse(
    readFileSync(new URL('../../public/data/brand.json', import.meta.url), 'utf-8'),
  );
} catch {
  /* fall back to plain text when data hasn't been built */
}
const brandCss = brand
  ? `@font-face{font-family:${JSON.stringify(brand.family)};` +
    `src:url(${JSON.stringify(withBase(`/data/${brand.file}`))}) format("woff2");` +
    `font-display:swap;}`
  : '';
---

<!doctype html>
<html lang={LANG_TAGS[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.tag} href={a.href} />
    ))}
    {alternates.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={withBase(`/${xDefaultLang}${path}`)} />
    )}
    <meta property="og:type" content={isHome ? 'website' : 'article'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={s.siteName} />
    <meta property="og:locale" content={LANG_TAGS[lang].replace('-', '_')} />
    {otherLangs.map((l) => (
      <meta property="og:locale:alternate" content={LANG_TAGS[l].replace('-', '_')} />
    ))}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site).href} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    {/* Structured data: lets search engines recognize this as a font collection with site search */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': isHome ? 'WebSite' : 'WebPage',
        name: s.siteName,
        description,
        url: canonical,
        inLanguage: LANG_TAGS[lang],
        license: 'https://opensource.org/licenses/MIT',
        ...(isHome && {
          potentialAction: {
            '@type': 'SearchAction',
            target: {
              '@type': 'EntryPoint',
              urlTemplate: `${abs(`/${lang}/`)}?q={search_term_string}`,
            },
            'query-input': 'required name=search_term_string',
          },
        }),
      })}
    />
    {brand && (
      <link rel="preload" as="font" type="font/woff2" crossorigin
            href={withBase(`/data/${brand.file}`)} />
    )}
    {brand && <style set:html={brandCss} />}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('opf-theme');
          var m =
            t ||
            (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = m;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body>
    {/* Lets keyboard/screen-reader users skip the whole header straight to main content; visible only on focus */}
    <a class="skip-link" href="#main">{s.skipToContent}</a>
    <header class="site-header">
      <div class="container site-header__row">
        <a class="site-brand" href={withBase(`/${lang}/`)}>
          <span
            class:list={['site-brand__name', brand && 'site-brand__name--pix']}
            style={brand ? `font-size:${brand.px * 2}px` : undefined}
          >
            {s.siteName}
          </span>
        </a>
        <nav class="site-nav" aria-label={s.siteNavLabel}>
          <a href={withBase(`/${lang}/`)}>{s.nav.catalogue}</a>
          <a href={withBase(`/${lang}/tools/`)}>{s.nav.tools}</a>
          <a href={withBase(`/${lang}/about/`)}>{s.nav.about}</a>
          {/* Pages that exist in one language only get no language button at all */}
          {otherLangs.length > 0 && (
            <details class="langmenu" data-testid="lang-menu">
              <summary aria-label={s.langLabel} title={s.langLabel}>
                <svg
                  class="icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m5 8 6 6" />
                  <path d="m4 14 6-6 2-3" />
                  <path d="M2 5h12" />
                  <path d="M7 2h1" />
                  <path d="m22 22-5-10-5 10" />
                  <path d="M14 18h6" />
                </svg>
              </summary>
              <ul>
                {otherLangs.map((l) => (
                  <li>
                    <a
                      href={withBase(`/${l}${path}`)}
                      data-lang-link
                      data-testid={l === other ? 'lang-switch' : undefined}
                      rel="alternate"
                      hreflang={LANG_TAGS[l]}>{LANG_NAMES[l]}</a
                    >
                  </li>
                ))}
              </ul>
            </details>
          )}
          <button
            type="button"
            class="theme-toggle"
            data-testid="theme-toggle"
            aria-label={s.themeToggle}
            title={s.themeToggle}
          >
            <svg
              class="icon icon--sun"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2" />
              <path d="M12 20v2" />
              <path d="m4.93 4.93 1.41 1.41" />
              <path d="m17.66 17.66 1.41 1.41" />
              <path d="M2 12h2" />
              <path d="M20 12h2" />
              <path d="m6.34 17.66-1.41 1.41" />
              <path d="m19.07 4.93-1.41 1.41" />
            </svg>
            <svg
              class="icon icon--moon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"
              />
            </svg>
          </button>
          <a
            class="nav-icon"
            href={REPO_URL}
            data-testid="github-link"
            aria-label={s.nav.github}
            title={s.nav.github}
          >
            <svg
              class="icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
              />
              <path d="M9 18c-4.51 2-5-2-7-2" />
            </svg>
          </a>
        </nav>
      </div>
      <hr class="hairline" style="margin:0" />
    </header>

    <script>
      // Switching language should stay on the "current page" — including the catalogue
      // page's search and filter state. The link is server-rendered and doesn't know the
      // client-side query, so append it from the current URL on click.
      document
        .querySelectorAll('[data-lang-link]')
        .forEach((el) =>
          el.addEventListener('click', (e) => {
            const a = e.currentTarget as HTMLAnchorElement;
            const extra = location.search + location.hash;
            if (extra) {
              e.preventDefault();
              location.href = a.pathname + extra;
            }
          }),
        );
    </script>

    <script>
      // The language menu follows the pointer and focus: expands on hover, collapses on
      // leave. <details> natively only responds to clicks, so we add this — but we keep
      // the native click behavior too, so touchscreens and devices without hover still work.
      document.querySelectorAll<HTMLDetailsElement>('.langmenu').forEach((menu) => {
        const summary = menu.querySelector('summary');
        if (!summary) return;
        let closeTimer = 0;
        const open = () => {
          clearTimeout(closeTimer);
          menu.open = true;
        };
        const close = () => {
          clearTimeout(closeTimer);
          menu.open = false;
        };

        if (matchMedia('(hover: hover)').matches) {
          menu.addEventListener('mouseenter', open);
          // The pointer crosses a small gap moving from summary to menu — buffer this
          // so it doesn't close midway
          menu.addEventListener('mouseleave', () => {
            closeTimer = window.setTimeout(close, 120);
          });
          // Hover already expanded it, so letting this click go through native toggle
          // would just close it again
          summary.addEventListener('click', (e) => {
            if (menu.open) e.preventDefault();
          });
        }

        menu.addEventListener('focusin', () => {
          // Only respond to keyboard-originated focus; leave mouse/touch-triggered focus
          // to <details> itself — otherwise focusin would open it and the native toggle
          // right after would close it again
          if (summary.matches(':focus-visible')) open();
        });
        menu.addEventListener('focusout', (e) => {
          const next = (e as FocusEvent).relatedTarget;
          if (!(next instanceof Node) || !menu.contains(next)) close();
        });
        menu.addEventListener('keydown', (e) => {
          if ((e as KeyboardEvent).key === 'Escape') {
            close();
            summary.focus();
          }
        });
      });
    </script>

    <main id="main" class="container site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <hr class="dotline" style="margin:0" />
      <div class="container site-footer__inner">
        <div class="site-footer__blurb">
          <p class="site-footer__name">{s.siteName}</p>
          <p>{s.siteTagline}</p>
        </div>
        <nav class="site-footer__links" aria-label={s.footer.navLabel}>
          <a href={withBase(`/${lang}/`)}>{s.nav.catalogue}</a>
          <a href={withBase(`/${lang}/tools/`)}>{s.nav.tools}</a>
          <a href={withBase(`/${lang}/about/`)}>{s.nav.about}</a>
          <a href={withBase(`/${lang}/about/#datasources`)}>{s.footer.dataSources}</a>
          <a href={REPO_URL} rel="noopener">{s.footer.sourceCode}</a>
        </nav>
        <div class="site-footer__legal">
          <p>{s.footer.disclaimer}</p>
          <p>
            {s.footer.siteLicense}{' '}
            {/* Copyright line skips i18n: the year and name are the same in every language, and it needs an embedded link */}
            <span class="site-footer__copy">
              © 2026 <a href="https://tomchen.org/" rel="noopener">Tom Chen</a>
            </span>
          </p>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.querySelector('[data-testid="theme-toggle"]');
      btn?.addEventListener('click', () => {
        const cur = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = cur;
        try {
          localStorage.setItem('opf-theme', cur);
        } catch {
          /* ignore, e.g. in private browsing mode */
        }
      });
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: var(--s3);
        top: -3rem;
        z-index: 100;
        padding: var(--s2) var(--s3);
        background: var(--surface);
        border: 1px solid var(--line);
        transition: top 0.15s;
      }
      .skip-link:focus {
        top: var(--s2);
      }
      .site-header__row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--s4);
        flex-wrap: wrap;
        padding-top: var(--s4);
        padding-bottom: var(--s3);
      }
      .site-brand {
        display: flex;
        align-items: baseline;
        gap: var(--s2);
        min-width: 0;
      }
      .site-brand__name {
        font-size: 1.35rem;
        font-weight: 700;
        letter-spacing: 0.02em;
      }
      /* Pixel web font: the font size must be an integer multiple of the native pixel
         size (inline style gives 2×); synthetic bold and letter spacing would both
         ruin the pixel grid */
      .site-brand__name--pix {
        font-family: 'FBF Brand', system-ui, sans-serif;
        font-weight: 400;
        letter-spacing: 0;
        line-height: 1;
        font-synthesis: none;
      }
      @media (max-width: 1100px) {
        }
      .site-nav {
        display: flex;
        align-items: center;
        flex-wrap: wrap; /* the four items don't fit at 300px wide, so allow wrapping */
        gap: var(--s2) var(--s4);
        font-size: 0.9rem;
        color: var(--ink-2);
      }
      .langmenu {
        position: relative;
      }
      .langmenu summary {
        cursor: pointer;
        list-style: none;
      }
      .langmenu summary::-webkit-details-marker {
        display: none;
      }
      .langmenu ul {
        position: absolute;
        right: 0;
        top: 1.6em;
        z-index: 20;
        margin: 0;
        padding: var(--s2) 0;
        list-style: none;
        background: var(--surface);
        border: 1px solid var(--line);
        min-width: 8rem;
      }
      .langmenu li a {
        display: block;
        padding: var(--s1) var(--s3);
        white-space: nowrap;
      }
      .langmenu li a:hover {
        background: var(--accent-soft);
      }
      /* There's a visual gap between summary and the menu — the pointer leaves .langmenu
         crossing it, triggering a close. Fill it with a transparent area — placed right
         under summary only, so it doesn't cover the nav links to the left when expanded. */
      .langmenu[open]::after {
        content: '';
        position: absolute;
        inset: 100% 0 auto 0;
        height: 0.8em;
      }
      .icon {
        width: 1.15em;
        height: 1.15em;
        display: block;
      }
      /* The button shows the icon for the "current" theme: sun in light mode, moon in dark mode */
      :root[data-theme='dark'] .icon--sun,
      :root:not([data-theme='dark']) .icon--moon {
        display: none;
      }
      .theme-toggle {
        border: none;
        padding: 0 var(--s1);
        font-size: 1rem;
        color: var(--ink-2);
      }
      .nav-icon {
        display: flex;
        align-items: center;
        padding: 0 var(--s1);
        color: var(--ink-2);
      }
      .site-main {
        min-height: 70vh;
        padding-top: var(--s5);
        padding-bottom: var(--s7);
      }
      .site-footer__inner {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
        gap: var(--s3) var(--s6);
        font-size: 0.8rem;
        color: var(--ink-3);
        padding-top: var(--s4);
        padding-bottom: var(--s5);
      }
      .site-footer__name {
        color: var(--ink-2);
        font-weight: 700;
      }
      .site-footer__inner p {
        margin: 0 0 var(--s1);
      }
      .site-footer__links {
        display: flex;
        flex-direction: column;
        gap: var(--s1);
        align-items: flex-start;
      }
      .site-footer__legal {
        grid-column: 1 / -1;
        border-top: 1px solid var(--line);
        padding-top: var(--s3);
      }
      @media (max-width: 640px) {
        .site-footer__inner {
          grid-template-columns: 1fr;
        }
      }
      @media (max-width: 640px) {
        .site-header__row {
          flex-direction: column;
          gap: var(--s2);
        }
      }
    </style>
  </body>
</html>
