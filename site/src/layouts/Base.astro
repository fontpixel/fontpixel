---
import '../styles/tokens.css';
import '../styles/transitions.css';
import SeoHead from '../components/SeoHead.astro';
import { readFileSync } from 'node:fs';
import { LANGS, LANG_NAMES, LANG_TAGS, t, otherLang, type Lang } from '../i18n';
import { withBase } from '../lib/data';
import { pageCopy } from '../i18n/page-copy';
import { DOC_LANGS } from '../lib/docs';
import { pageTransitionScript } from '../lib/viewtransition';
import { DEFAULT_PALETTE, PALETTES, SWATCHES } from '../lib/palettes';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Path without the language prefix, e.g. "/fonts/galmuri/" — used for hreflang and language switching */
  path: string;
  markdownPath?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  /** Language versions this page actually exists in; defaults to all. English-only
   * docs pages pass ['en'] — the language menu and hreflang only list these. */
  availableLangs?: Lang[];
  /** What this page is *about*, for structured data — the font's name on a font
   * page. Without it every page reports the site's name and search engines see a
   * thousand pages all called the same thing. Defaults to the site name. */
  entityName?: string;
  /** Canonical URL of the licence covering this page's subject. Only the home page
   * carries the site's own licence; a font page that claimed it would be stating
   * MIT over a font that is GPL or public domain. */
  licenseUrl?: string;
  /** Full-width header and main, for the tools/docs pages that follow the
   * original Docusaurus layout (DocsLayout lays out the main area itself). */
  wide?: boolean;
}

const REPO_URL = 'https://github.com/fontpixel/fontpixel';
const { lang, path, availableLangs, wide } =
  Astro.props;
const langs = availableLangs ?? LANGS;
const otherLangs = langs.filter((l) => l !== lang);
const s = t(lang);
const other = otherLang(lang);
const docLang = DOC_LANGS.includes(lang) ? lang : DOC_LANGS[0]!;
const isHome = path === '/' || /^\/page\/\d+\/$/.test(path);
// Which side of the catalogue ⇄ font-page transition this page is (styles/transitions.css).
const vtPage = isHome ? 'catalogue' : /^\/fonts\/[^/]+\/$/.test(path) ? 'font' : undefined;
const vtScript = pageTransitionScript(import.meta.env.BASE_URL, LANGS);
const githubLinks: [string, string][] = [
  // Product names, the same in every language
  ['https://github.com/fontpixel/bdfparser-js', 'BDF Parser (TS/JS)'],
  ['https://github.com/fontpixel/bdfparser', 'BDF Parser (Python)'],
  ['https://github.com/fontpixel/font-template', s.githubMenu.fontTemplate],
  ['https://github.com/fontpixel/fontpixel', s.githubMenu.website],
  ['https://github.com/tomchen', s.githubMenu.follow],
];

// The site name uses a pixel web font subsetted at build time (brand.woff2, a few KB,
// cached once site-wide), replacing the old per-page canvas rendering. brand is null
// when data hasn't been built, falling back to the system font.
let brand: { file: string; px: number; family: string } | null = null;
try {
  brand = JSON.parse(
    readFileSync(new URL('../../public/data/brand.json', import.meta.url), 'utf-8'),
  );
} catch {
  /* fall back to plain text when data hasn't been built */
}
const brandCss = brand
  ? `@font-face{font-family:${JSON.stringify(brand.family)};` +
    `src:url(${JSON.stringify(withBase(`/data/${brand.file}`))}) format("woff2");` +
    `font-display:swap;}`
  : '';
---

<!doctype html>
<html lang={LANG_TAGS[lang]} data-vt-page={vtPage}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead {...Astro.props} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="16x16" />
    {brand && (
      <link rel="preload" as="font" type="font/woff2" crossorigin
            href={withBase(`/data/${brand.file}`)} />
    )}
    {brand && <style set:html={brandCss} />}
    <script is:inline define:vars={{ palettes: PALETTES, defaultPalette: DEFAULT_PALETTE }}>
      (function () {
        var root = document.documentElement;
        try {
          var t = localStorage.getItem('opf-theme');
          var m =
            t ||
            (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          root.dataset.theme = m;
          var p = localStorage.getItem('opf-palette');
          root.dataset.palette = palettes.indexOf(p) >= 0 ? p : defaultPalette;
        } catch (e) {
          root.dataset.theme = 'light';
          root.dataset.palette = defaultPalette;
        }
        // Lets CSS collapse the catalogue's filter panel from the first paint on
        // narrow screens; the island drops the class once it can do it natively.
        if (matchMedia('(max-width: 900px)').matches) {
          document.documentElement.classList.add('narrow');
        }
      })();
    </script>
    {/* Classic and in <head>: pagereveal can fire before any module script runs. */}
    <script is:inline set:html={vtScript} />
  </head>
  <body>
    {/* Keyboard/screen-reader shortcuts are visible only while focused. */}
    <div class="skip-links">
      <a class="skip-link" href="#main">{s.skipToContent}</a>
      {isHome && (
        <a class="skip-link" href="#catalogue-results" data-testid="skip-to-results">
          {s.catalogue.skipToResults}
        </a>
      )}
    </div>
    <header class="site-header">
      <div class:list={['container site-header__row', { 'container--wide': wide }]}>
        <a class="site-brand" href={withBase(`/${lang}/`)}>
          <span
            class:list={['site-brand__name', brand && 'site-brand__name--pix']}
            style={brand ? `font-size:${brand.px * 2}px` : undefined}
          >
            {s.siteName}
          </span>
        </a>
        <nav class="site-nav" aria-label={s.siteNavLabel}>
          <a
            class="nav-icon"
            href={withBase(`/${lang}/compare/`)}
            data-vt-nav
            aria-label={s.compare.title}
            title={s.compare.title}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="icon lucide lucide-equal-approximately preview-icon"
              aria-hidden="true"
            >
              <path d="M5 15a6.5 6.5 0 0 1 7 0 6.5 6.5 0 0 0 7 0" />
              <path d="M5 9a6.5 6.5 0 0 1 7 0 6.5 6.5 0 0 0 7 0" />
            </svg>
          </a>
          {/* The icon itself links to the tools page; hovering (or a tap on touch
              screens, which cannot hover) opens the menu of individual tools. */}
          <div class="navmenu toolsmenu" data-nav-menu data-testid="tools-menu">
            <a
              class="navmenu__trigger"
              href={withBase(`/${lang}/tools/`)}
              data-vt-nav
              aria-label={s.nav.tools}
              title={s.nav.tools}
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="tools-menu-popup"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon lucide lucide-pocket-knife preview-icon"
                aria-hidden="true"
              >
                <path d="M3 2v1c0 1 2 1 2 2S3 6 3 7s2 1 2 2-2 1-2 2 2 1 2 2" />
                <path d="M18 6h.01" />
                <path d="M6 18h.01" />
                <path d="M20.83 8.83a4 4 0 0 0-5.66-5.66l-12 12a4 4 0 1 0 5.66 5.66Z" />
                <path d="M18 11.66V22a4 4 0 0 0 4-4V6" />
              </svg>
            </a>
            <ul id="tools-menu-popup" role="menu" data-menu-popup hidden>
              {s.tools.cards.map((card) => (
                <li role="none">
                  <a role="menuitem" tabindex="-1" href={withBase(`/${docLang}/${card.slug}/`)} data-vt-nav>
                    {card.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <a
            class="nav-icon"
            href={withBase(`/${lang}/about/`)}
            data-vt-nav
            aria-label={s.nav.about}
            title={s.nav.about}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="icon lucide lucide-info preview-icon"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10" />
              <path d="M12 16v-4" />
              <path d="M12 8h.01" />
            </svg>
          </a>
          {/* Pages that exist in one language only get no language button at all */}
          {otherLangs.length > 0 && (
            <div class="navmenu langmenu" data-nav-menu data-testid="lang-menu">
              <button
                type="button"
                class="navmenu__trigger"
                aria-label={s.langLabel}
                title={s.langLabel}
                aria-haspopup="menu"
                aria-expanded="false"
                aria-controls="language-menu-popup"
              >
                <svg
                  class="icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m5 8 6 6" />
                  <path d="m4 14 6-6 2-3" />
                  <path d="M2 5h12" />
                  <path d="M7 2h1" />
                  <path d="m22 22-5-10-5 10" />
                  <path d="M14 18h6" />
                </svg>
              </button>
              <ul id="language-menu-popup" role="menu" data-menu-popup hidden>
                {otherLangs.map((l) => (
                  <li role="none">
                    <a
                      role="menuitem"
                      tabindex="-1"
                      href={withBase(`/${l}${path}`)}
                      data-lang-link
                      data-testid={l === other ? 'lang-switch' : undefined}
                      rel="alternate"
                      hreflang={LANG_TAGS[l]}>{LANG_NAMES[l]}</a
                    >
                  </li>
                ))}
              </ul>
            </div>
          )}
          {/* The icon shows the current mode (sun: light, moon: dark); its menu has
              a row per palette, each offering that palette's light and dark
              theme as a swatch drawn in the theme's own paper and accent. */}
          <div class="navmenu thememenu" data-nav-menu data-testid="theme-menu">
            <button
              type="button"
              class="navmenu__trigger theme-toggle"
              data-testid="theme-toggle"
              aria-label={s.theme.label}
              title={s.theme.label}
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="theme-menu-popup"
            >
              <svg
                class="icon icon--sun"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2" />
                <path d="M12 20v2" />
                <path d="m4.93 4.93 1.41 1.41" />
                <path d="m17.66 17.66 1.41 1.41" />
                <path d="M2 12h2" />
                <path d="M20 12h2" />
                <path d="m6.34 17.66-1.41 1.41" />
                <path d="m19.07 4.93-1.41 1.41" />
              </svg>
              <svg
                class="icon icon--moon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path
                  d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"
                />
              </svg>
            </button>
            <ul id="theme-menu-popup" role="menu" aria-label={s.theme.label} data-menu-popup hidden>
              {PALETTES.map((palette) => (
                <li role="none" class="thememenu__row">
                  <span class="thememenu__name" aria-hidden="true">{s.theme.palettes[palette]}</span>
                  {(['light', 'dark'] as const).map((mode) => (
                    <button
                      type="button"
                      role="menuitemradio"
                      tabindex="-1"
                      aria-checked="false"
                      class="thememenu__swatch"
                      data-theme-palette={palette}
                      data-theme-mode={mode}
                      aria-label={`${s.theme.palettes[palette]} · ${s.theme[mode]}`}
                      title={`${s.theme.palettes[palette]} · ${s.theme[mode]}`}
                      style={`--sw-paper:${SWATCHES[palette][mode].paper};--sw-accent:${SWATCHES[palette][mode].accent}`}
                    >
                      {mode === 'light' ? (
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2M12 20v2m-7.07-17.07 1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
                      </svg>
                      ) : (
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />
                      </svg>
                      )}
                    </button>
                  ))}
                </li>
              ))}
              <li role="none" class="thememenu__system">
                <button type="button" role="menuitemcheckbox" tabindex="-1" aria-checked="false" data-theme-system>
                  <svg class="thememenu__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  {s.theme.system}
                </button>
              </li>
            </ul>
          </div>
          {/* Like the tools icon: the icon links to this site's repository, hovering or
              tapping opens the menu of the author's related repositories. */}
          <div class="navmenu githubmenu" data-nav-menu data-testid="github-menu">
            <a
              class="navmenu__trigger"
              href={REPO_URL}
              target="_blank"
              rel="noopener noreferrer"
              data-testid="github-link"
              aria-label={s.nav.github}
              title={s.nav.github}
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="github-menu-popup"
            >
              <svg
                class="icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path
                  d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
                />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </svg>
            </a>
            <ul id="github-menu-popup" role="menu" data-menu-popup hidden>
              {githubLinks.map(([href, label]) => (
                <li role="none">
                  <a role="menuitem" tabindex="-1" href={href} target="_blank" rel="noopener noreferrer">
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </nav>
      </div>
      <hr class="hairline" style="margin:0" />
    </header>

    <script>
      import { revealFragment } from '../lib/fragments';

      revealFragment();
      window.addEventListener('hashchange', () => revealFragment('auto'));
      window.addEventListener('load', () => revealFragment(), { once: true });

      // Switching language should stay on the "current page" — including the catalogue
      // page's search and filter state. The link is server-rendered and doesn't know the
      // client-side query, so append it from the current URL on click.
      document
        .querySelectorAll('[data-lang-link]')
        .forEach((el) =>
          el.addEventListener('click', (e) => {
            const a = e.currentTarget as HTMLAnchorElement;
            const extra = location.search + location.hash;
            if (extra) {
              e.preventDefault();
              location.href = a.pathname + extra;
            }
          }),
        );
    </script>

    <script>
      // Each header dropdown is one Tab stop. Arrow keys enter and move through
      // its menu items; the popup follows its icon and stays inside the viewport.
      const navMenus = [...document.querySelectorAll<HTMLElement>('[data-nav-menu]')];
      const menuTrigger = (menu: HTMLElement) =>
        menu.querySelector<HTMLElement>('.navmenu__trigger');
      const menuPopup = (menu: HTMLElement) =>
        menu.querySelector<HTMLElement>('[data-menu-popup]');
      const menuItems = (menu: HTMLElement) =>
        [...menu.querySelectorAll<HTMLElement>('[role^="menuitem"]')].filter(
          (item) => item.getAttribute('aria-disabled') !== 'true',
        );
      const menuIsOpen = (menu: HTMLElement) =>
        menuTrigger(menu)?.getAttribute('aria-expanded') === 'true';

      const closeMenu = (menu: HTMLElement) => {
        const trigger = menuTrigger(menu);
        const popup = menuPopup(menu);
        if (!trigger || !popup) return;
        trigger.setAttribute('aria-expanded', 'false');
        popup.hidden = true;
        delete menu.dataset.open;
        delete menu.dataset.menuSide;
        delete menu.dataset.menuClipped;
      };

      const placeMenu = (menu: HTMLElement) => {
        const trigger = menuTrigger(menu);
        const popup = menu.querySelector<HTMLElement>('[data-menu-popup]');
        if (!trigger || !popup || !menuIsOpen(menu)) return;

        const gutter = 8;
        const viewportWidth = document.documentElement.clientWidth;
        popup.style.left = '0px';
        popup.style.right = 'auto';
        popup.style.top = '100%';
        popup.style.bottom = 'auto';
        popup.style.maxHeight = '';
        popup.style.maxWidth = `${viewportWidth}px`;
        delete menu.dataset.menuClipped;

        const menuRect = menu.getBoundingClientRect();
        const triggerRect = trigger.getBoundingClientRect();
        // Layout size, not getBoundingClientRect: the popup is still scaled down
        // while its opening animation runs. (Computed style rather than offset*,
        // which round and can leave it a fraction of a pixel past the edge.)
        const popupStyle = getComputedStyle(popup);
        const popupWidth = parseFloat(popupStyle.width);
        const viewportLeft = popupWidth <= viewportWidth
          ? Math.min(Math.max(triggerRect.left, 0), viewportWidth - popupWidth)
          : 0;
        popup.style.left = `${viewportLeft - menuRect.left}px`;

        const below = Math.max(0, window.innerHeight - triggerRect.bottom - gutter);
        const above = Math.max(0, triggerRect.top - gutter);
        const naturalHeight = parseFloat(popupStyle.height);
        const viewportHeight = Math.max(0, window.innerHeight - gutter * 2);
        if (naturalHeight <= below) {
          menu.dataset.menuSide = 'bottom';
        } else if (naturalHeight <= above) {
          popup.style.top = 'auto';
          popup.style.bottom = '100%';
          menu.dataset.menuSide = 'top';
        } else if (naturalHeight <= viewportHeight) {
          const viewportTop = Math.min(
            Math.max(triggerRect.bottom, gutter),
            window.innerHeight - naturalHeight - gutter,
          );
          popup.style.top = `${viewportTop - menuRect.top}px`;
          menu.dataset.menuSide = 'free';
        } else {
          const openAbove = above > below;
          popup.style.top = openAbove ? 'auto' : '100%';
          popup.style.bottom = openAbove ? '100%' : 'auto';
          popup.style.maxHeight = `${openAbove ? above : below}px`;
          menu.dataset.menuSide = openAbove ? 'top' : 'bottom';
          menu.dataset.menuClipped = '';
        }
      };

      const openMenu = (menu: HTMLElement, focus: 'none' | 'first' | 'last' = 'none') => {
        const trigger = menuTrigger(menu);
        const popup = menuPopup(menu);
        if (!trigger || !popup) return;
        navMenus.forEach((other) => {
          if (other !== menu) closeMenu(other);
        });
        popup.hidden = false;
        trigger.setAttribute('aria-expanded', 'true');
        menu.dataset.open = '';
        requestAnimationFrame(() => {
          placeMenu(menu);
          if (focus !== 'none') {
            const items = menuItems(menu);
            (focus === 'first' ? items[0] : items.at(-1))?.focus();
          }
        });
      };

      navMenus.forEach((menu) => {
        const trigger = menuTrigger(menu);
        const popup = menuPopup(menu);
        if (!trigger || !popup) return;
        // A trigger that is also a link (tools) goes to its page when clicked or
        // activated with Enter; a tap on a touch screen opens the menu instead.
        const isLink = trigger instanceof HTMLAnchorElement;
        let pointerType = '';
        let closeTimer = 0;
        let openedByHover = false;
        let suppressFocusOpen = false;
        const open = (focus: 'none' | 'first' | 'last' = 'none') => {
          clearTimeout(closeTimer);
          openMenu(menu, focus);
        };
        const close = () => {
          clearTimeout(closeTimer);
          openedByHover = false;
          closeMenu(menu);
        };

        if (matchMedia('(hover: hover)').matches) {
          menu.addEventListener('mouseenter', () => {
            if (!menuIsOpen(menu)) openedByHover = true;
            open();
          });
          // The pointer crosses a small gap moving from trigger to menu — buffer this
          // so it doesn't close midway
          menu.addEventListener('mouseleave', () => {
            closeTimer = window.setTimeout(() => {
              if (!menu.contains(document.activeElement)) close();
            }, 120);
          });
        }

        trigger.addEventListener('pointerdown', (event) => (pointerType = event.pointerType));
        trigger.addEventListener('click', (event) => {
          const tapped = pointerType === 'touch' || pointerType === 'pen';
          pointerType = '';
          if (isLink) {
            if (!tapped) return;
            event.preventDefault();
          }
          if (openedByHover) {
            openedByHover = false;
            return;
          }
          if (menuIsOpen(menu)) close();
          else open();
        });
        trigger.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowDown') {
            event.preventDefault();
            open('first');
          } else if (event.key === 'ArrowUp') {
            event.preventDefault();
            open('last');
          } else if (event.key === ' ' || (event.key === 'Enter' && !isLink)) {
            event.preventDefault();
            open('first');
          } else if (event.key === 'Escape') {
            event.preventDefault();
            close();
          }
        });
        menu.addEventListener('focusin', () => {
          if (!suppressFocusOpen && trigger.matches(':focus-visible')) open();
        });
        menu.addEventListener('focusout', (e) => {
          const next = (e as FocusEvent).relatedTarget;
          if (!(next instanceof Node) || !menu.contains(next)) close();
        });
        popup.addEventListener('keydown', (event) => {
          const items = menuItems(menu);
          const index = items.indexOf(document.activeElement as HTMLElement);
          let nextIndex: number | undefined;
          if (event.key === 'ArrowDown') nextIndex = (index + 1) % items.length;
          else if (event.key === 'ArrowUp') nextIndex = (index - 1 + items.length) % items.length;
          else if (event.key === 'Home') nextIndex = 0;
          else if (event.key === 'End') nextIndex = items.length - 1;
          else if (event.key === 'Escape') {
            event.preventDefault();
            close();
            suppressFocusOpen = true;
            trigger.focus();
            requestAnimationFrame(() => (suppressFocusOpen = false));
            return;
          }
          if (nextIndex !== undefined && items.length) {
            event.preventDefault();
            items[nextIndex]!.focus();
          }
        });
      });
      document.addEventListener('pointerdown', (event) => {
        const target = event.target;
        if (!(target instanceof Node)) return;
        navMenus.forEach((menu) => {
          if (!menu.contains(target)) closeMenu(menu);
        });
      });
      window.addEventListener('resize', () =>
        navMenus.filter(menuIsOpen).forEach(placeMenu),
      );
    </script>

    <main id="main" class:list={['container site-main', { 'site-main--wide': wide }]} tabindex="-1">
