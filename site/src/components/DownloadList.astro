---
import { t, type Lang } from '../i18n';
import { formatBytes } from '../lib/format';
import type { FontDetail } from '../lib/schema';
import { Code } from 'astro:components';

interface Props {
  lang: Lang;
  detail: FontDetail;
  base: string; // download base URL
}
const { lang, detail, base } = Astro.props;
const s = t(lang);
const byVariant = new Map<string, typeof detail.downloads>();
let zip: (typeof detail.downloads)[number] | undefined;
const ttfs: typeof detail.downloads = [];
// Vector TTF appears once per typeface (not per variant), same family-level scope as bitmap TTF/ZIP
const vecs: typeof detail.downloads = [];
// woff2 for web use, with a ready-made @font-face rule underneath the table
const webfonts: typeof detail.downloads = [];
for (const e of detail.downloads) {
  if (e.kind === 'zip') zip = e;
  else if (e.kind === 'ttf') ttfs.push(e);
  else if (e.kind === 'ttf-square' || e.kind === 'ttf-round') vecs.push(e);
  else if (e.kind === 'woff2-square' || e.kind === 'woff2-round') webfonts.push(e);
  else {
    const list = byVariant.get(e.variantId!) ?? [];
    list.push(e);
    byVariant.set(e.variantId!, list);
  }
}
const kindLabel: Record<string, string> = {
  bdf: s.detail.downloadBdf,
  pcf: s.detail.downloadPcf,
  'ttf-square': s.detail.downloadTtfSquare,
  'ttf-round': s.detail.downloadTtfRound,
  'woff2-square': s.detail.downloadWoff2Square,
  'woff2-round': s.detail.downloadWoff2Round,
};
const cssFamily = detail.meta.name.replace(/"/g, '');
/** Generic family to fall back on, worked out from what the collection already
 * knows about the face — but only when it can be justified.
 *
 * Whether a font is monospaced comes from its own metrics, so that answer is
 * solid and takes precedence: a fallback that keeps columns lined up matters
 * more than one that matches the stroke texture. A terminal face counts as
 * monospace whatever its metrics say, since that is what it is for. The rest
 * follows the curated `forms` field — Song/Mincho, Fangsong, Kai and pixel
 * serifs are serif; gothic, sans and rounded are sans-serif. Decorative and
 * script faces get no generic at all rather than a guess, since the wrong
 * stand-in is worse than none.
 */
const SERIF_FORMS = new Set(['song', 'serif', 'fangsong', 'kai']);
const SANS_FORMS = new Set(['sans', 'gothic', 'rounded']);
function genericFor(file: string): string {
  const forms = detail.meta.forms;
  if (forms.includes('terminal')) return 'monospace';
  // The filename carries the group's spacing whenever it varies within a family
  if (/-monospaced-/.test(file)) return 'monospace';
  if (!/-proportional-/.test(file)) {
    const spacings = new Set(detail.meta.variants.map((v) => v.spacing));
    if (spacings.size === 1 && spacings.has('monospaced')) return 'monospace';
  }
  if (forms.some(form => SERIF_FORMS.has(form))) return 'serif';
  if (forms.some(form => SANS_FORMS.has(form))) return 'sans-serif';
  return '';
}
// The snippet is meant to be pasted into someone else's page, so the URL has
// to be absolute; in production `base` already points at the download host.
const absBase = /^https?:/.test(base) ? base : new URL(base, Astro.site).href.replace(/\/$/, '');
const webfontCss = webfonts.map((e) => {
  return [
    '@font-face {',
    `  font-family: "${cssFamily}";`,
    `  src: url("${absBase}/${e.file}") format("woff2");`,
    '  font-display: fallback;',
    '}',
    '',
    '.pixel {',
    (() => {
      const g = genericFor(e.file);
      return `  font-family: "${cssFamily}"${g ? `, ${g}` : ''};`;
    })(),
    '}',
  ].filter(Boolean).join('\n');
});
---

<section id="downloads" class="dl" data-testid="download-list">
  <h2>{s.detail.downloadsTitle}</h2>
  <table class="dl__table">
    <tbody>
      {
        [...byVariant.entries()].map(([variantId, entries]) => (
          <tr>
            <th scope="row" class="mono">
              {variantId}
            </th>
            <td>
              {entries.map((e) => (
                <a
                  class="dl__link"
                  rel="noopener noreferrer"
                  href={`${base}/${e.file}`}
                  download={e.file}
                  data-kind={e.kind}
                  title={`SHA-256 ${e.sha256}`}
                >
                  {kindLabel[e.kind] ?? e.kind}
                  <span class="dl__size mono">{formatBytes(e.bytes)}</span>
                </a>
              ))}
            </td>
          </tr>
        ))
      }
      {
        zip && (
          <tr>
            <th scope="row">{s.detail.downloadZip}</th>
            <td>
              <a
                class="dl__link"
                rel="noopener noreferrer"
                href={`${base}/${zip.file}`}
                download={zip.file}
                data-kind="zip"
                title={`SHA-256 ${zip.sha256}`}
              >
                {zip.file}
                <span class="dl__size mono">{formatBytes(zip.bytes)}</span>
              </a>
            </td>
          </tr>
        )
      }
      {
        ttfs.map((e) => (
          <tr>
            <th scope="row">{s.detail.downloadTtf}</th>
            <td>
              <a
                class="dl__link"
                rel="noopener noreferrer"
                href={`${base}/${e.file}`}
                download={e.file}
                data-kind="ttf"
                title={`SHA-256 ${e.sha256}`}
              >
                {e.file}
                <span class="dl__size mono">{formatBytes(e.bytes)}</span>
              </a>
            </td>
          </tr>
        ))
      }
      {
        [...vecs, ...webfonts].map((e) => (
          <tr>
            <th scope="row">{kindLabel[e.kind] ?? e.kind}</th>
            <td>
              <a
                class="dl__link"
                rel="noopener noreferrer"
                href={`${base}/${e.file}`}
                download={e.file}
                data-kind={e.kind}
                title={`SHA-256 ${e.sha256}`}
              >
                {e.file}
                <span class="dl__size mono">{formatBytes(e.bytes)}</span>
              </a>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <p class="dl__note">{s.detail.downloadNote}</p>
  {ttfs.length > 0 && <p class="dl__note">{s.detail.downloadTtfNote}</p>}
  {vecs.length > 0 && <p class="dl__note">{s.detail.downloadVectorNote}</p>}
</section>

  {
    webfonts.length > 0 && (
      <section id="webfont" class="dl__webfont" data-testid="webfont-css">
        <div class="dl__webfont-head">
          <h2>{s.detail.webfontTitle}</h2>
          {webfonts.length > 1 && (
            <select
              class="dl__webfont-pick"
              name="webfont-file"
              data-webfont-pick
              aria-label={s.detail.webfontTitle}
            >
              {webfonts.map((e, i) => (
                <option value={i}>{e.file}</option>
              ))}
            </select>
          )}
          <button
            type="button"
            class="dl__webfont-show"
            data-webfont-show
            aria-expanded="false"
            data-show-label={s.detail.webfontShow}
            data-hide-label={s.detail.webfontHide}
          >
            {s.detail.webfontShow}
          </button>
          <button type="button" class="dl__webfont-copy" data-webfont-copy>
            {s.detail.webfontCopy}
          </button>
        </div>
        <p class="dl__note">{s.detail.webfontNote}</p>
        <div class="dl__webfont-box" data-webfont-box hidden>
          {webfontCss.map((css, i) => (
            <div data-webfont-css={i} hidden={i !== 0}>
              <Code code={css} lang="css" themes={{ light: 'github-light', dark: 'github-dark' }} />
            </div>
          ))}
        </div>
      </section>
    )
  }

<script>
  import { setRevealed } from '../lib/reveal';

  // Switch which @font-face block is on show, and copy it.
  const box = document.querySelector<HTMLElement>('[data-testid="webfont-css"]');
  if (box) {
    const blocks = [...box.querySelectorAll<HTMLElement>('[data-webfont-css]')];
    const pick = box.querySelector<HTMLSelectElement>('[data-webfont-pick]');
    pick?.addEventListener('change', () => {
      blocks.forEach((b, i) => (b.hidden = i !== Number(pick.value)));
    });
    const wrap = box.querySelector<HTMLElement>('[data-webfont-box]');
    const show = box.querySelector<HTMLButtonElement>('[data-webfont-show]');
    show?.addEventListener('click', () => {
      if (!wrap) return;
      const open = show.getAttribute('aria-expanded') !== 'true';
      setRevealed(wrap, open);
      show.setAttribute('aria-expanded', String(open));
      show.textContent = open ? (show.dataset.hideLabel ?? '') : (show.dataset.showLabel ?? '');
    });
    const btn = box.querySelector<HTMLButtonElement>('[data-webfont-copy]');
    btn?.addEventListener('click', () => {
      const shown = blocks.find((b) => !b.hidden);
      if (!shown) return;
      navigator.clipboard?.writeText(shown.textContent ?? '').then(() => {
        const label = btn.textContent;
        btn.textContent = btn.dataset.done ?? '✓';
        setTimeout(() => (btn.textContent = label), 1200);
      });
    });
  }
</script>

<style>
  .dl__webfont-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s2);
  }
  .dl__webfont-head h2 {
    flex-basis: 100%;
  }
  .dl__webfont-pick {
    min-width: 0;
    max-width: 100%;
  }
  .dl__webfont-head :is(select, button) {
    font-size: 0.85rem;
  }
  .dl__webfont-box {
    border: 1px solid var(--line);
    background: var(--surface);
    margin-top: var(--s2);
    overflow-x: auto;
  }
  .dl__webfont-box :global(pre) {
    margin: 0;
    padding: var(--s3);
    font-size: 0.75rem;
    line-height: 1.5;
    background: none !important;
  }

  .dl h2,
  .dl__webfont h2 {
    font-size: 1rem;
    margin: 0 0 var(--s3);
  }
  .dl {
    /* Filename + size don't fit on a 300px screen; let the download
       table scroll horizontally on its own instead of blowing out the page */
    overflow-x: auto;
    max-width: 100%;
  }
  .dl__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .dl__table th,
  .dl__table td {
    text-align: left;
    padding: var(--s2) var(--s3) var(--s2) 0;
    border-top: 1px dotted var(--line);
    font-weight: 400;
  }
  .dl__link {
    display: inline-flex;
    gap: var(--s2);
    align-items: baseline;
    margin-right: var(--s4);
    color: var(--accent);
    /* 23.8px tall as laid out, just under the 24px minimum touch target */
    min-height: 24px;
  }
  .dl__link:hover,
  .dl__link:focus-visible {
    background: var(--accent-soft);
    text-decoration: underline;
    text-underline-offset: .2em;
  }
  .dl__link:hover .dl__size,
  .dl__link:focus-visible .dl__size {
    color: var(--accent);
  }
  .dl__size {
    color: var(--ink-3);
    font-size: 0.75rem;
  }
  .dl__note {
    color: var(--ink-3);
    font-size: 0.75rem;
  }
</style>
