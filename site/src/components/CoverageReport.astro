---
import { pickText, t, type Lang } from '../i18n';
import type { CharsetMeta } from '../lib/data';
import type { FontDetail } from '../lib/schema';
import CjkCoverage from './CjkCoverage.astro';
import { cjkText } from '../i18n/cjk';
import { CJK_COVERAGE_ROWS, coverageTree } from '../lib/coverage-tree';

interface Props {
  lang: Lang;
  initialVariant: string;
  detail: FontDetail;
  sections: string[];
  charsets: CharsetMeta[];
  /** Variant groups: variants with the same signature share one panel (attr is a space-separated list of variant ids) */
  groups: { ids: string[]; repId: string; attr: string }[];
  variants: { id: string; label: string }[];
}
const { lang, detail, sections, charsets, groups, variants, initialVariant } = Astro.props;
const s = t(lang);
const cjk = cjkText(lang);
const coverageCopy: Record<string, string> = { ...cjk.labels, ...cjk.coverage };
const tableSections = sections.flatMap(sec => sec === 'intl' ? [sec, 'cjk'] : [sec]);
const name = (c: CharsetMeta) => pickText(lang, c.nameZh, c.nameEn);
const desc = (c: CharsetMeta) => pickText(lang, c.descZh, c.descEn);
const bySection = new Map<string, CharsetMeta[]>();
for (const c of charsets) {
  const list = bySection.get(c.section) ?? [];
  list.push(c);
  bySection.set(c.section, list);
}
const pct = (have: number, total: number) =>
  total === 0 ? '0' : ((have / total) * 100).toFixed(have === total ? 0 : 2);
---

<section id="coverage" class="cov" data-testid="coverage-report">
  <div class="cov__head">
    <h2>{s.detail.coverageTitle}</h2>
    {/* Coverage changes with the variant, and by now the variant dropdown at the top has scrolled out of view */}
    <label class="cov__pick"
      >{s.detail.variants}
      <select name="coverage-variant" data-coverage-variant data-testid="coverage-variant">
        {variants.map((v) => (
          <option value={v.id} selected={v.id === initialVariant}>{v.label}</option>
        ))}
      </select>
    </label>
  </div>
  {
    groups.map((g) => {
      const cov = detail.coverage[g.repId]!;
      const ov = detail.overview[g.repId]!;
      const blocks = detail.unicodeBlocks[g.repId]!;
      const missing = detail.missingChars[g.repId] ?? {};
      return (
        <div data-variant-panel={g.attr} hidden={!g.ids.includes(initialVariant)}>
          <section id={`coverage-overview-${g.repId}`} class="cov__overview">
            <h3>{s.coverage.sections['overview']}</h3>
            <div class="cov__scroll" tabindex="0">
              <table class="cov__table">
                <tbody>
                  <tr>
                    <th>{s.coverage.totalEncoded}</th>
                    <td class="mono">
                      {ov.total[0]!.toLocaleString()} / {ov.total[1]!.toLocaleString()}
                    </td>
                    <td class="mono cov__pct">{pct(ov.total[0]!, ov.total[1]!)}%</td>
                    <td />
                  </tr>
                  {ov.planes
                    .filter((p) => p[1] > 0)
                    .map((p) => (
                      <tr class="cov__sub">
                        <th>{p[0]}</th>
                        <td class="mono">
                          {p[1].toLocaleString()} / {p[2].toLocaleString()}
                        </td>
                        <td class="mono cov__pct">{pct(p[1], p[2])}%</td>
                        <td />
                      </tr>
                    ))}
                  {ov.compat[0]! > 0 && (
                    <tr data-coverage-summary="compat">
                      <th>
                        {s.coverage.compat}
                        <span class="cov__note" title={s.coverage.compatNote}>
                          *
                        </span>
                      </th>
                      <td class="mono">
                        {ov.compat[0]} / {ov.compat[1]}
                      </td>
                      <td class="mono cov__pct">{pct(ov.compat[0]!, ov.compat[1]!)}%</td>
                      <td />
                    </tr>
                  )}
                  {ov.pua.some((p) => p[1] > 0) &&
                    ov.pua.map((p) => (
                      <tr class="cov__sub">
                        <th>
                          {s.coverage.pua} · {p[0]}
                        </th>
                        <td class="mono">
                          {p[1].toLocaleString()} / {p[2].toLocaleString()}
                        </td>
                        <td class="mono cov__pct">{pct(p[1], p[2])}%</td>
                        <td />
                      </tr>
                    ))}
                </tbody>
              </table>
            </div>
          </section>

          {tableSections.map((sec) => {
            const rows = coverageTree([
              ...(bySection.get(sec) ?? []).filter((c) => cov[c.id]).map((c) => ({
                id: c.id, label: coverageCopy[c.id] ?? name(c),
                description: coverageCopy[c.id] ?? desc(c), source: c.source, pair: cov[c.id]!,
              })),
              ...(CJK_COVERAGE_ROWS[sec] ?? []).map((key) => ({
                id: key, label: coverageCopy[key]!, description: coverageCopy[key]!,
                source: 'https://www.unicode.org/versions/Unicode17.0.0/',
                pair: detail.cjkCoverage[g.repId]![key]!,
              })),
            ]);
            if (!rows.length) return null;
            return (
              <>
              <section id={`coverage-${sec}-${g.repId}`} class="cov__section">
                <h3>{sec === 'cjk' ? cjk.coverageTitle : s.coverage.sections[sec] ?? sec}</h3>
                <div class="cov__scroll" tabindex="0">
                  <table class="cov__table">
                    <tbody>
                      {rows.map((c) => {
                        const [have, total] = c.pair;
                        const ratio = total ? have / total : 0;
                        const filled = Math.round(ratio * 100);
                        const miss = missing[c.id];
                        return (
                          <tr data-charset={c.id} data-coverage-parent={c.parent}
                            class:list={{ 'cov__sub': c.depth > 0 }} style={`--coverage-depth:${c.depth}`}>
                            <th title={`${c.description}\n${s.coverage.sourceLabel}:${c.source}`}>
                              {c.label}
                            </th>
                            <td class="mono">
                              {have.toLocaleString()} / {total.toLocaleString()}
                            </td>
                            <td class="mono cov__pct">{pct(have, total)}%</td>
                            <td class="cov__barcell">
                              <span
                                class="pxbar"
                                class:list={[{ full: have === total }]}
                                style={`--fill:${filled}%`}
                              />
                              {have === total ? (
                                <span class="cov__full">✓ {s.coverage.complete}</span>
                              ) : (
                                miss && (
                                  <>
                                    <button
                                      type="button"
                                      class="cov__missbtn"
                                      data-missing
                                    >
                                      {s.coverage.missingChars} {total - have}
                                    </button>
                                    <div
                                      class="cov__miss-src"
                                      hidden
                                      data-label={c.label}
                                      data-chars={miss}
                                    >
                                    </div>
                                  </>
                                )
                              )}
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              </section>
              {sec === 'intl' && <CjkCoverage lang={lang} coverage={detail.cjkCoverage[g.repId]!} id={`cjk-${g.repId}`} />}
              </>
            );
          })}

          <details id={`unicode-blocks-${g.repId}`} class="cov__blocks">
            <summary>
              {s.coverage.unicodeBlocks}({blocks.filter((b) => b[1] > 0).length})
            </summary>
            <div class="cov__scroll" tabindex="0">
              <table class="cov__table">
                <tbody>
                  {blocks
                    .filter((b) => b[1] > 0)
                    .map((b) => (
                      <tr>
                        <th>{b[0]}</th>
                        <td class="mono">
                          {b[1].toLocaleString()} / {b[2].toLocaleString()}
                        </td>
                        <td class="mono cov__pct">{pct(b[1], b[2])}%</td>
                        <td class="cov__barcell">
                          <span
                            class="pxbar"
                            style={`--fill:${Math.round((b[1] / b[2]) * 100)}%`}
                          />
                        </td>
                      </tr>
                    ))}
                </tbody>
              </table>
            </div>
          </details>
        </div>
      );
    })
  }

  <dialog class="cov__modal" data-missing-modal data-copied-label={s.coverage.copiedChar} aria-labelledby="missing-modal-title">
    <div class="cov__modal-head">
      <h3 id="missing-modal-title" class="cov__modal-title" data-modal-title />
      <button type="button" class="cov__modal-copyall" data-modal-copyall
        >{s.coverage.copyAll}</button
      >
      <button
        type="button"
        class="cov__modal-close"
        data-modal-close
        aria-label={s.coverage.close}>×</button
      >
    </div>
    <div class="cov__modal-body" data-modal-body role="toolbar" aria-labelledby="missing-modal-title" />
    <p class="visually-hidden" role="status" data-modal-status />
  </dialog>
</section>

<script>
  import { rovingFocus } from '../lib/roving-focus';
  // Two-way sync with the variant dropdown at the top of the page: both sides dispatch the same event, whichever changes first drives the other
  const pick = document.querySelector<HTMLSelectElement>('[data-coverage-variant]');
  if (pick) {
    pick.addEventListener('change', () => {
      document.dispatchEvent(
        new CustomEvent('opf:variantchange', { detail: { id: pick.value } }),
      );
    });
    document.addEventListener('opf:variantchange', (e) => {
      const id = (e as CustomEvent).detail?.id;
      if (id && pick.value !== id) pick.value = id;
    });
  }

  // The missing-glyph list is shown in a modal: a cell can't hold thousands of characters,
  // and expanding it inline would break the table layout. The content is already rendered
  // as a compact string; buttons are created when the shared dialog opens.
  const dlg = document.querySelector<HTMLDialogElement>('[data-missing-modal]');
  if (dlg) {
    const title = dlg.querySelector('[data-modal-title]')!;
    const body = dlg.querySelector<HTMLElement>('[data-modal-body]')!;
    rovingFocus(body);
    document.querySelectorAll('[data-missing]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.nextElementSibling as HTMLElement | null;
        if (!src) return;
        title.textContent = `${src.dataset.label ?? ''} · ${btn.textContent?.trim() ?? ''}`;
        body.replaceChildren(...Array.from(src.dataset.chars ?? '', (ch) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'cov__miss';
          button.textContent = ch;
          button.title = `U+${ch.codePointAt(0)!.toString(16).toUpperCase().padStart(4, '0')}`;
          button.setAttribute('aria-label', `${ch} ${button.title}`);
          return button;
        }));
        dlg.showModal();
      });
    });
    // Clicking one glyph copies just that glyph; the header button copies the lot.
    const copied = dlg.dataset.copiedLabel ?? 'Copied';
    const flash = (el: HTMLElement) => {
      dlg.querySelector('[data-modal-status]')!.textContent = `${copied}: ${el.textContent}`;
      el.classList.add('cov__miss--copied');
      setTimeout(() => el.classList.remove('cov__miss--copied'), 600);
    };
    body.addEventListener('click', (e) => {
      const cell = (e.target as HTMLElement).closest<HTMLElement>('.cov__miss');
      if (!cell) return;
      navigator.clipboard?.writeText(cell.textContent ?? '').then(() => flash(cell));
    });
    const copyAll = dlg.querySelector<HTMLButtonElement>('[data-modal-copyall]');
    copyAll?.addEventListener('click', () => {
      const all = [...body.querySelectorAll('.cov__miss')].map((n) => n.textContent ?? '').join('');
      navigator.clipboard?.writeText(all).then(() => {
        const label = copyAll.textContent;
        copyAll.textContent = copied;
        setTimeout(() => (copyAll.textContent = label), 1200);
      });
    });
    dlg.querySelector('[data-modal-close]')?.addEventListener('click', () => dlg.close());
    // Close on backdrop click: a click landing on the dialog itself (not its content) counts as a backdrop click
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
  }
</script>

<style>
  .cov h2 {
    font-size: 1rem;
    margin: 0 0 var(--s3);
  }
  .cov h3 {
    font-size: 0.85rem;
    color: var(--ink-2);
    margin: var(--s4) 0 var(--s2);
    letter-spacing: 0.02em;
  }
  /* The table is inherently wide (charset name + count + percentage + bar + missing count);
     on narrow screens let it scroll horizontally within its own box instead of forcing the whole page to scroll */
  .cov__scroll {
    overflow-x: auto;
  }
  .cov__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
  }
  .cov__table th {
    text-align: left;
    font-weight: 400;
    padding: 3px var(--s3) 3px 0;
    border-top: 1px dotted var(--line);
    width: 40%;
    min-width: 14rem;
  }
  .cov__table td {
    padding: 3px var(--s3) 3px 0;
    border-top: 1px dotted var(--line);
    white-space: nowrap;
  }
  .cov__sub th {
    padding-left: calc(var(--s4) * var(--coverage-depth, 1));
    color: var(--ink-3);
  }
  .cov__pct {
    text-align: right;
    color: var(--ink-2);
    width: 5em;
  }
  .cov__barcell {
    width: 30%;
  }
  /* Pixel-block progress bar: pure CSS, two layered gradients */
  .pxbar {
    display: inline-block;
    vertical-align: middle;
    width: 7.5rem;
    height: 0.55rem;
    background:
      repeating-linear-gradient(
        to right,
        transparent 0,
        transparent calc(0.375rem - 1px),
        var(--paper) calc(0.375rem - 1px),
        var(--paper) 0.375rem
      ),
      linear-gradient(to right, var(--accent) var(--fill, 0%), var(--line-soft) var(--fill, 0%));
  }
  .pxbar.full {
    background:
      repeating-linear-gradient(
        to right,
        transparent 0,
        transparent calc(0.375rem - 1px),
        var(--paper) calc(0.375rem - 1px),
        var(--paper) 0.375rem
      ),
      linear-gradient(to right, var(--accent), var(--accent));
  }
  .cov__full {
    color: var(--accent);
    font-size: 0.75rem;
    margin-left: var(--s2);
  }
  .cov__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s2) var(--s4);
    flex-wrap: wrap;
  }
  /* flex children default to min-width:auto: a long label in the variant selector would break the header row */
  .cov__head > * {
    min-width: 0;
    max-width: 100%;
  }
  .cov__head select {
    max-width: 100%;
  }
  .cov__pick {
    font-size: 0.82rem;
    color: var(--ink-2);
  }
  .cov__missbtn {
    margin-left: var(--s2);
    font-size: 0.75rem;
    color: var(--ink-2);
    background: none;
    border: 1px solid var(--line);
    padding: 0 var(--s2);
    cursor: pointer;
  }
  .cov__missbtn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .cov__modal {
    /* Keep focus inside the viewport when showModal() runs, without scrolling the page. */
    position: fixed;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    padding: 0;
    width: min(42rem, 92vw);
    max-height: 80vh;
  }
  .cov__modal::backdrop {
    background: rgb(0 0 0 / 0.45);
  }
  .cov__modal-head {
    display: flex;
    align-items: baseline;
    gap: var(--s3);
    padding: var(--s3) var(--s4);
    padding-right: 2.5rem;
    border-bottom: 1px solid var(--line);
  }
  .cov__modal-title {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .cov__modal-copyall {
    flex: none;
    font-size: 0.75rem;
    padding: var(--s1) var(--s2);
  }
  .cov__modal-close {
    position: absolute;
    top: 0;
    right: 0;
    width: 2.4rem;
    height: 2.4rem;
    border: none;
    background: none;
    color: var(--ink-3);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    padding: 0 var(--s1);
  }
  .cov__modal-close:hover {
    color: var(--accent);
  }
  .cov__modal-body {
    padding: var(--s4);
    overflow: auto;
    max-height: calc(80vh - 3rem);
    overflow-wrap: anywhere;
    font-size: 1rem;
  }
  /* Each missing glyph gets a light border; hover shows its codepoint, click copies it */
  .cov__miss {
    display: inline-block;
    border: 1px solid var(--line-soft);
    border-radius: 0;
    background: none;
    color: inherit;
    font: inherit;
    padding: 0 2px;
    margin: 1px;
    line-height: 1.5;
    cursor: pointer;
  }
  .cov__miss:hover {
    border-color: var(--accent);
  }
  .cov__miss--copied {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .cov__note {
    color: var(--accent);
    cursor: help;
  }
  .cov__blocks {
    margin-top: var(--s4);
  }
  .cov__blocks summary {
    cursor: pointer;
    font-size: 0.85rem;
    color: var(--ink-2);
  }
</style>
