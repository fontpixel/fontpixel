---
/** Hover tooltip (ported from the original site's Tooltip.js, rc-tooltip replaced with plain CSS). */
interface Props {
  tip: string;
}
const { tip } = Astro.props;
const id = `tooltip-${crypto.randomUUID()}`;
---

<span class="tt" tabindex="0" aria-describedby={id}><span class="tt__text"><slot /></span><span class="tt__mark" aria-hidden="true">?</span><span id={id} class="tt__tip" role="tooltip">{tip}</span></span>

<script>
  for (const tip of document.querySelectorAll<HTMLElement>('.tt')) {
    tip.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') { event.preventDefault(); tip.dataset.dismissed = ''; }
    });
    tip.addEventListener('blur', () => { delete tip.dataset.dismissed; });
    tip.addEventListener('mouseleave', () => { delete tip.dataset.dismissed; });
  }
</script>

<style>
  .tt {
    position: relative;
    cursor: help;
  }
  .tt__text {
    border-bottom: 1px dotted var(--ink-3);
  }
  .tt__mark {
    display: inline-block;
    margin-left: 0.15em;
    font-size: 0.7em;
    vertical-align: super;
    color: var(--ink-3);
  }
  .tt__tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 6px);
    transform: translateX(-50%);
    width: max-content;
    max-width: 280px;
    background: var(--ink);
    color: var(--paper);
    padding: var(--s1) var(--s2);
    font-size: 0.8rem;
    line-height: 1.5;
    visibility: hidden;
    z-index: 10;
  }
  .tt:hover .tt__tip,
  .tt:focus .tt__tip {
    visibility: visible;
  }
  .tt[data-dismissed] .tt__tip { visibility: hidden; }
</style>
