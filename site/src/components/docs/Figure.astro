---
/** Doc figure (ported from the original site's Figure.js). When imgUrl is true, src resolves to a file under public/img/. */
interface Props {
  src: string;
  caption?: string;
  figure_number?: string | number;
  width?: string | number;
  imgUrl?: boolean;
  link?: string;
  position?: 'left' | 'right' | string;
}
const { src, caption, figure_number, width, imgUrl, link, position } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const finalSrc = imgUrl ? `${base}/img/${src}` : src;
const float = position === 'left' || position === 'right' ? position : 'none';
---

<div style="display: flow-root">
  <figure style={`float: ${float}; text-align: center; margin: 1em;`}>
    {link ? (
      <a href={link}><img alt={caption} src={finalSrc} width={width} /></a>
    ) : (
      <img alt={caption} src={finalSrc} width={width} />
    )}
    <figcaption style="font-style: italic">
      {figure_number && <strong>Figure {figure_number} </strong>}{caption}
    </figcaption>
  </figure>
</div>
