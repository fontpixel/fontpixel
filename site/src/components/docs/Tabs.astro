---
/** Same API as Docusaurus's Tabs (values / defaultValue / groupId),
 * so merged-in MDX needs no markup changes. Without JS, tabs stack (progressive enhancement).
 */
interface Props {
  groupId?: string;
  defaultValue?: string;
  values?: { label: string; value: string }[];
}
const { groupId, defaultValue, values = [] } = Astro.props;
---

<div
  class="tabs"
  data-tabs
  data-group={groupId}
  data-default={defaultValue}
  data-values={JSON.stringify(values)}
>
  <slot />
</div>

<script>
  for (const [index, root] of document.querySelectorAll<HTMLElement>('[data-tabs]').entries()) {
    if (root.dataset.ready) continue;
    root.dataset.ready = '1';
    const values: { label: string; value: string }[] = JSON.parse(root.dataset.values || '[]');
    const items = [...root.querySelectorAll<HTMLElement>(':scope > [data-tab-value]')];
    if (!items.length) continue;
    const labelOf = (v: string) =>
      values.find((x) => x.value === v)?.label ??
      items.find((i) => i.dataset.tabValue === v)?.dataset.tabLabel ??
      v;
    const group = root.dataset.group;
    const key = group ? `opf-tabs-${group}` : '';
    const bar = document.createElement('div');
    bar.className = 'tabs__bar';
    bar.setAttribute('role', 'tablist');
    bar.setAttribute('aria-label', group || 'Examples');
    const show = (v: string) => {
      if (!items.some((it) => it.dataset.tabValue === v)) return;
      for (const it of items) it.hidden = it.dataset.tabValue !== v;
      for (const b of bar.children) {
        const selected = (b as HTMLElement).dataset.v === v;
        b.classList.toggle('on', selected);
        b.setAttribute('aria-selected', String(selected));
        (b as HTMLElement).tabIndex = selected ? 0 : -1;
      }
    };
    for (const it of items) {
      const v = it.dataset.tabValue!;
      // A doc can contain several tab groups with the same language names.
      it.id ||= `tab-${index + 1}-${v}`;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.id = `${it.id}-tab`;
      btn.setAttribute('role', 'tab');
      btn.setAttribute('aria-controls', it.id);
      it.setAttribute('role', 'tabpanel');
      it.setAttribute('aria-labelledby', btn.id);
      it.tabIndex = 0;
      btn.dataset.v = v;
      btn.textContent = labelOf(v);
      btn.addEventListener('click', () => {
        show(v);
        if (key) {
          try {
            localStorage.setItem(key, v);
          } catch {
            /* fine if this fails in private-browsing mode */
          }
        }
        if (group)
          for (const other of document.querySelectorAll<HTMLElement>(`[data-tabs][data-group="${group}"]`))
            if (other !== root) other.dispatchEvent(new CustomEvent('opf-tab', { detail: v }));
      });
      bar.append(btn);
    }
    root.prepend(bar);
    bar.addEventListener('keydown', (event) => {
      const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const current = buttons.indexOf(document.activeElement as HTMLButtonElement);
      if (current < 0) return;
      const next = event.key === 'ArrowRight' ? (current + 1) % buttons.length
        : event.key === 'ArrowLeft' ? (current - 1 + buttons.length) % buttons.length
        : event.key === 'Home' ? 0 : event.key === 'End' ? buttons.length - 1 : -1;
      if (next < 0) return;
      event.preventDefault();
      buttons[next]!.focus();
      buttons[next]!.click();
    });
    root.addEventListener('opf-tab', ((e: CustomEvent<string>) => show(e.detail)) as EventListener);
    let init = root.dataset.default || items[0]!.dataset.tabValue!;
    if (key) {
      try {
        const saved = localStorage.getItem(key);
        if (saved && items.some((i) => i.dataset.tabValue === saved)) init = saved;
      } catch {
        /* same as above */
      }
    }
    show(init);
  }
</script>

<style>
  .tabs {
    border: 1px solid var(--line);
    background: var(--surface);
    padding: var(--s2) var(--s3);
    margin: var(--s4) 0;
  }
  .tabs :global(.tabs__bar) {
    display: flex;
    gap: var(--s1);
    flex-wrap: wrap;
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--s2);
  }
  .tabs :global(.tabs__bar button) {
    border: none;
    border-bottom: 2px solid transparent;
    background: none;
    padding: var(--s1) var(--s2);
    cursor: pointer;
    color: var(--ink-2);
    font: inherit;
    font-size: 0.85rem;
  }
  .tabs :global(.tabs__bar button.on) {
    color: var(--accent);
    border-bottom-color: var(--accent);
    font-weight: 700;
  }
</style>
