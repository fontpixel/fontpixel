---
import { licenseShortLabel } from '../lib/licenselabel';
import { pickText, t, toHant, type Lang } from '../i18n';
import { withBase } from '../lib/data';
import type { FontDetail } from '../lib/schema';

interface Props {
  lang: Lang;
  detail: FontDetail;
  licenseText: string | null;
}
const { lang, detail, licenseText } = Astro.props;
const s = t(lang);
const m = detail.meta;
const lic = m.license;
// Values are all resolved via pickText: Traditional is converted from Simplified, other languages fall back to English
// CJK languages use full-width parens, others use half-width
const cjk = lang === 'zh' || lang === 'zh-Hant' || lang === 'ja';
// The author list switches language as a whole set (not item-by-item pairing: the Chinese and
// English lists may not split the same way); Traditional is converted from Simplified like the rest of the site's Chinese
const authors = (
  lang === 'zh' || lang === 'zh-Hant'
    ? m.authors
    : m.authorsEn.length
      ? m.authorsEn
      : m.authors
).map((a) => (lang === 'zh-Hant' ? toHant(a) : a));
const licName = pickText(lang, lic.name, lic.nameEn);
const licNote = pickText(lang, detail.licenseNote, detail.licenseNoteEn);
const prov = pickText(lang, detail.provenance, detail.provenanceEn);
---

<aside class="side">
  <dl class="side__list">
    {
      authors.length > 0 && (
        <>
          <dt>{s.detail.author}</dt>
          {/* Each author links to the catalogue page searched by their name, making it easy to find their other fonts */}
          <dd data-testid="meta-author">
            {authors.map((a, i) => (
              <>{i > 0 ? (cjk ? '、' : ', ') : ''}<a href={withBase(`/${lang}/?q=${encodeURIComponent(a)}`)}>{a}</a></>
            ))}
          </dd>
        </>
      )
    }
    {
      detail.homepage && (
        <>
          <dt>{s.detail.homepage}</dt>
          <dd>
            <a href={detail.homepage} rel="noopener">
              {detail.homepage.replace(/^https?:\/\//, '')}
            </a>
          </dd>
        </>
      )
    }
    {
      detail.repository && (
        <>
          <dt>{s.detail.repository}</dt>
          <dd>
            <a href={detail.repository} rel="noopener">
              {detail.repository.replace(/^https?:\/\/(github\.com\/)?/, '')}
            </a>
          </dd>
        </>
      )
    }
    <dt>{s.detail.glyphCount}</dt>
    <dd class="mono">{m.glyphCount.toLocaleString()}</dd>
    {
      m.scripts.length > 0 && (
        <>
          <dt>{s.catalogue.scripts}</dt>
          {/* Each item links to the catalogue page filtered by that script */}
          <dd>
            {m.scripts.map((sc, i) => (
              <>{i > 0 ? ' · ' : ''}<a href={withBase(`/${lang}/?scripts=${encodeURIComponent(sc)}`)} title={s.scriptRules[sc] ?? ''}>{s.scriptNames[sc] ?? sc}</a></>
            ))}
          </dd>
        </>
      )
    }
    {
      m.vibes.length > 0 && (
        <>
          <dt>{s.catalogue.vibes}</dt>
          {/* Same as above: links to the catalogue page filtered by that vibe tag */}
          <dd>
            {m.vibes.map((v, i) => (
              <>{i > 0 ? ' · ' : ''}<a href={withBase(`/${lang}/?vibes=${encodeURIComponent(v)}`)}>{s.vibeNames[v] ?? v}</a></>
            ))}
          </dd>
        </>
      )
    }
  </dl>


  <section class="side__license" data-testid="license-box">
    <h3>{s.detail.licenseTitle}</h3>
    <p class="side__licname">
      {lic.spdx && <span class="chip mono">{licenseShortLabel(lic.spdx)}</span>}
      <span>{licName}</span>
    </p>
    {licNote && <p class="side__licnote">{licNote}</p>}
    {
      licenseText && (
        <details data-testid="license-details">
          <summary>{s.detail.licenseViewFull}</summary>
          <pre class="side__lictext">{licenseText}</pre>
        </details>
      )
    }
    <p class="side__disclaimer">{s.detail.licenseDisclaimer}</p>
  </section>

  {
    (prov || detail.warnings.length > 0) && (
      <details class="side__notes" data-testid="build-notes">
        <summary>{s.detail.buildNotes}</summary>
        {prov && <p class="side__prov">{prov}</p>}
        {detail.warnings.length > 0 && (
          <>
            <p class="side__warnhead">
              {s.detail.warningsTitle}
              {cjk ? `（${detail.warnings.length}）` : ` (${detail.warnings.length})`}
            </p>
            <ul class="side__warnlist">
              {detail.warnings.slice(0, 20).map((w) => (
                <li class="mono">{w}</li>
              ))}
            </ul>
          </>
        )}
      </details>
    )
  }
</aside>

<style>
  .side {
    font-size: 0.85rem;
  }
  .side__list {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s1) var(--s3);
    margin: 0 0 var(--s4);
  }
  .side__list dt {
    color: var(--ink-3);
    white-space: nowrap;
  }
  .side__list dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .side__license {
    border-top: 1px dotted var(--line);
    padding-top: var(--s3);
  }
  .side__license h3 {
    font-size: 0.8rem;
    color: var(--ink-2);
    margin: 0 0 var(--s2);
  }
  .side__licname {
    display: flex;
    gap: var(--s2);
    align-items: center;
    margin: 0 0 var(--s1);
  }
  .side__licmeta {
    color: var(--ink-2);
    display: flex;
    gap: var(--s2);
    align-items: center;
    flex-wrap: wrap;
    margin: 0;
  }
  .side__licnote {
    color: var(--ink-2);
    font-size: 0.8rem;
  }
  .side__lictext {
    max-height: 20rem;
    overflow: auto;
    font-size: 0.7rem;
    background: var(--surface);
    border: 1px solid var(--line);
    padding: var(--s3);
    white-space: pre-wrap;
  }
  .side__disclaimer,
  .hint {
    color: var(--ink-3);
    font-size: 0.75rem;
  }
  .side__notes {
    margin-top: var(--s4);
    color: var(--ink-2);
  }
  .side__notes summary,
  .side__license summary {
    cursor: pointer;
    font-size: 0.8rem;
    color: var(--ink-3);
  }
  .side__prov {
    font-size: 0.75rem;
    color: var(--ink-3);
    overflow-wrap: anywhere;
  }
  .side__warnhead {
    font-size: 0.75rem;
    color: var(--ink-3);
    margin: var(--s2) 0 var(--s1);
  }
  .side__warnlist {
    font-size: 0.72rem;
    padding-left: 1.2em;
  }
  .side__converted {
    margin: 0 0 var(--s3);
  }
</style>
