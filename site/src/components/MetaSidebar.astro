---
import { licenseShortLabel } from '../lib/licenselabel';
import { pickText, t, toHant, type Lang } from '../i18n';
import LicenseSummary from './LicenseSummary.astro';
import { withBase } from '../lib/data';
import type { FontDetail } from '../lib/schema';

interface Props {
  lang: Lang;
  detail: FontDetail;
  licenseText: string | null;
}
const { lang, detail, licenseText } = Astro.props;
const s = t(lang);
const m = detail.meta;
const lic = m.license;
// Values are all resolved via pickText: Traditional is converted from Simplified, other languages fall back to English
// CJK languages use full-width parens, others use half-width
const cjk = lang === 'zh' || lang === 'zh-Hant' || lang === 'ja';
// The author list switches language as a whole set (not item-by-item pairing: the Chinese and
// English lists may not split the same way); Traditional is converted from Simplified like the rest of the site's Chinese
const authors = (
  lang === 'zh' || lang === 'zh-Hant'
    ? m.authors
    : m.authorsEn.length
      ? m.authorsEn
      : m.authors
).map((a) => (lang === 'zh-Hant' ? toHant(a) : a));
const licName = pickText(lang, lic.name, lic.nameEn);
const licNote = pickText(lang, detail.licenseNote, detail.licenseNoteEn);
const prov = pickText(lang, detail.provenance, detail.provenanceEn);
---

<aside id="font-info" class="side">
  <dl class="side__list">
    {
      authors.length > 0 && (
        <>
          <dt>{s.detail.author}</dt>
          {/* Each author links to the catalogue page searched by their name, making it easy to find their other fonts */}
          <dd data-testid="meta-author">
            {authors.map((a, i) => (
              <>{i > 0 ? (cjk ? '、' : ', ') : ''}<a href={withBase(`/${lang}/?q=${encodeURIComponent(a)}`)}>{a}</a></>
            ))}
          </dd>
        </>
      )
    }
    {
      detail.homepage && (
        <>
          <dt>{s.detail.homepage}</dt>
          <dd>
            <a href={detail.homepage} target="_blank" rel="noopener noreferrer">
              {detail.homepage.replace(/^https?:\/\//, '')}
            </a>
          </dd>
        </>
      )
    }
    {
      detail.repository && (
        <>
          <dt>{s.detail.repository}</dt>
          <dd>
            <a href={detail.repository} target="_blank" rel="noopener noreferrer">
              {detail.repository.replace(/^https?:\/\/(github\.com\/)?/, '')}
            </a>
          </dd>
        </>
      )
    }
    <dt>{s.detail.glyphCount}</dt>
    <dd class="mono">{m.glyphCount.toLocaleString()}</dd>
    {
      m.forms.length > 0 && (
        <>
          <dt>{s.catalogue.form}</dt>
          <dd>
            {m.forms.map((form, i) => (
              <>{i > 0 ? ' · ' : ''}<a href={withBase(`/${lang}/?forms=${encodeURIComponent(form)}`)}>{s.forms[form] ?? form}</a></>
            ))}
          </dd>
        </>
      )
    }
    {
      m.scripts.length > 0 && (
        <>
          <dt>{s.catalogue.scripts}</dt>
          {/* Each item links to the catalogue page filtered by that script */}
          <dd>
            {m.scripts.map((sc, i) => (
              <>{i > 0 ? ' · ' : ''}<a href={withBase(`/${lang}/?scripts=${encodeURIComponent(sc)}`)} title={s.scriptRules[sc] ?? ''}>{s.scriptNames[sc] ?? sc}</a></>
            ))}
          </dd>
        </>
      )
    }
    {
      m.vibes.length > 0 && (
        <>
          <dt>{s.catalogue.vibes}</dt>
          {/* Same as above: links to the catalogue page filtered by that vibe tag */}
          <dd>
            {m.vibes.map((v, i) => (
              <>{i > 0 ? ' · ' : ''}<a href={withBase(`/${lang}/?vibes=${encodeURIComponent(v)}`)}>{s.vibeNames[v] ?? v}</a></>
            ))}
          </dd>
        </>
      )
    }
    {m.sourceKind && (
      <>
        <dt>{s.detail.sourceType}</dt>
        <dd>
          {m.sourceKind === 'bitmap' ? s.detail.sourceBitmap : s.detail.sourcePixelOutline}
          {m.sourceFormats?.length ? ` · ${m.sourceFormats.join(' / ')}` : ''}
        </dd>
      </>
    )}
  </dl>


  <section id="license" class="side__license" data-testid="license-box">
    <h3>{s.detail.licenseTitle}</h3>
    <p class="side__licname">
      {lic.spdx && <span class="chip mono">{licenseShortLabel(lic.spdx)}</span>}
      <span>{licName}</span>
    </p>
    <LicenseSummary lang={lang} spdx={lic.spdx} />
    {
      licenseText && (
        <details id="license-text" data-testid="license-details">
          <summary>
            {detail.licenseTextCanonical
              ? s.detail.licenseViewCanonical
              : s.detail.licenseViewFull}
          </summary>
          {detail.licenseTextCanonical && (
            <p class="side__licnote">{s.detail.licenseCanonicalNote}</p>
          )}
          <pre class="side__lictext">{licenseText}</pre>
        </details>
      )
    }
    {
      licNote && (
        <details id="license-notes" class="side__licnotes" data-testid="license-notes">
          <summary>{s.detail.licenseNotes}</summary>
          <p class="side__licnote">{licNote}</p>
        </details>
      )
    }
    <p class="side__disclaimer">{s.detail.licenseDisclaimer}</p>
  </section>

  {
    (prov || detail.warnings.length > 0) && (
      <details id="build-notes" class="side__notes" data-testid="build-notes">
        <summary>{s.detail.buildNotes}</summary>
        {prov && <p class="side__prov">{prov}</p>}
        {detail.warnings.length > 0 && (
          <>
            <p class="side__warnhead">
              {s.detail.warningsTitle}
              {cjk ? `（${detail.warnings.length}）` : ` (${detail.warnings.length})`}
            </p>
            <ul class="side__warnlist">
              {detail.warnings.slice(0, 20).map((w) => (
                <li class="mono">{w}</li>
              ))}
            </ul>
          </>
        )}
      </details>
    )
  }
</aside>

<style>
  .side {
    font-size: 0.85rem;
  }
  .side__list {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s1) var(--s3);
    margin: 0 0 var(--s4);
  }
  .side__list dt {
    color: var(--ink-3);
    white-space: nowrap;
  }
  .side__list dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .side__license {
    border-top: 1px dotted var(--line);
    padding-top: var(--s3);
  }
  .side__license h3 {
    font-size: 0.8rem;
    color: var(--ink-2);
    margin: 0 0 var(--s2);
  }
  .side__licname {
    display: flex;
    gap: var(--s2);
    align-items: baseline;
    flex-wrap: wrap;
    margin: 0 0 var(--s1);
  }
  /* The chip is a fixed token; a long licence name should wrap under it
     rather than squeeze it, and never the other way round. */
  .side__licname .chip {
    flex: none;
  }
  .side__licname > span:not(.chip) {
    flex: 1 1 12rem;
    min-width: 0;
  }
  .side__licmeta {
    color: var(--ink-2);
    display: flex;
    gap: var(--s2);
    align-items: center;
    flex-wrap: wrap;
    margin: 0;
  }
  .side__licnotes,
  .side__license details[data-testid='license-details'] {
    margin-top: var(--s4);
  }
  .side__licnote {
    color: var(--ink-2);
    font-size: 0.8rem;
  }
  .side__lictext {
    max-height: 20rem;
    overflow: auto;
    font-size: 0.75rem;
    background: var(--surface);
    border: 1px solid var(--line);
    padding: var(--s3);
    white-space: pre-wrap;
  }
  .side__disclaimer,
  .hint {
    color: var(--ink-3);
    font-size: 0.75rem;
  }
  .side__notes {
    margin-top: var(--s4);
    color: var(--ink-2);
  }
  .side__notes summary,
  .side__license summary,
  .side__licnotes summary {
    cursor: pointer;
    font-size: 0.8rem;
    color: var(--ink-3);
  }
  .side__prov {
    font-size: 0.75rem;
    color: var(--ink-3);
    overflow-wrap: anywhere;
  }
  .side__warnhead {
    font-size: 0.75rem;
    color: var(--ink-3);
    margin: var(--s2) 0 var(--s1);
  }
  .side__warnlist {
    font-size: 0.75rem;
    padding-left: 1.2em;
  }
  .side__converted {
    margin: 0 0 var(--s3);
  }
</style>
