---
import { pageCopy } from '../../../i18n/page-copy';
import Base from '../../../layouts/Base.astro';
import Compare from '../../../islands/Compare.svelte';
import { LANGS, t, type Lang } from '../../../i18n';
import { withBase } from '../../../lib/data';
import { loadCatalogue } from '../../../lib/catalogue-build';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const s = t(lang);
const index = loadCatalogue();
// The page is static, so the preselection is read on the client from ?v=…;
// server-side we only need the family list.
---

<Base lang={lang} title={`${s.compare.title} · ${s.siteName}`} description={pageCopy[lang].compare} path="/compare/">
  <h1>{s.compare.title}</h1>
  <Compare
    client:load
    families={index.families}
    s={s}
    lang={lang}
    dataBase={withBase('/data')}
    initial={[]}
  />
</Base>
