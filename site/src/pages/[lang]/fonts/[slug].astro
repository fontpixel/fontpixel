---
import Base from '../../../layouts/Base.astro';
import { previewFor } from '../../../lib/preview';
import CoverageReport from '../../../components/CoverageReport.astro';
import InkDiagram from '../../../components/InkDiagram.astro';
import MetaSidebar from '../../../components/MetaSidebar.astro';
import DownloadList from '../../../components/DownloadList.astro';
import GlyphGrid from '../../../islands/GlyphGrid.svelte';
import SampleEditor from '../../../islands/SampleEditor.svelte';
import Icon from '../../../islands/Icon.svelte';
import { LANGS, pickName, pickText, t, type Lang } from '../../../i18n';
import {
  downloadsBase,
  listDetailSlugs,
  loadCharsetsMeta,
  loadDetail,
  readLicenseText,
  readPreviewSvg,
  withBase,
} from '../../../lib/data';

export function getStaticPaths() {
  return listDetailSlugs().flatMap((slug) => [
    ...LANGS.map((lang) => ({ params: { lang, slug } })),
  ]);
}

const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug!;
const s = t(lang);
const detail = loadDetail(slug);
const m = detail.meta;
const preview = previewFor(m);
const displayName = pickName(lang, m.names, m.name);
// spdx.org publishes a page per licence id, which is the canonical URL schema.org's
// `license` wants. Skipped for LicenseRef-* (no such page) and for compound
// expressions, where no single page describes the terms -- better to say nothing
// than to point at half of them.
const spdxUrl = (id: string | null) =>
  id && !id.startsWith('LicenseRef-') && !id.includes(' ')
    ? `https://spdx.org/licenses/${id}.html`
    : undefined;

// Sizes overview: multi-variant families get a comparison table below the intro.
// For families like Galmuri, where "upstream numbering, recommended size, declared
// line height, ink height" are four numbers that don't agree, this makes it clear at a glance.
const hasDisplaySize = m.variants.some((v) => v.displaySize > 0);
// Row order follows meta.variants' original order (build.py sorts by size → weight → layout),
// kept consistent with the variant dropdown on the page — no separate ordering rule here
const sizeRows = m.variants
  .map((v) => {
    const mm = detail.metrics[v.id];
    return {
      id: v.id,
      size: v.size,
      displaySize: v.displaySize,
      hanInk: mm?.hanInk ? `${mm.hanInk[0]}×${mm.hanInk[1]}` : s.detail.hanInkNone,
      maxInk: mm?.maxInk ? `${mm.maxInk[0]}×${mm.maxInk[1]}` : '—',
    };
  });
const displayDesc = pickText(lang, detail.description, detail.descriptionEn);
const licenseText = readLicenseText(slug);
let previewSvg = '';
try {
  previewSvg = readPreviewSvg(preview.file);
} catch {
  /* ignore when no pre-rendered preview exists */
}
const dlBase = downloadsBase();
const variantIds = m.variants.map((v) => v.id);
const blocksByVariant = Object.fromEntries(
  Object.entries(detail.unicodeBlocks).map(([vid, bs]) => [
    vid,
    bs.filter(([, covered]) => covered > 0).map(([name]) => name),
  ]),
);
const charsetsMeta = loadCharsetsMeta();

// Variant grouping: variants with the same signature share one SSR panel, bringing
// pages for families like ark-pixel (35 variants) back down from hundreds of KB to normal.
// Metrics change with size while coverage usually doesn't, hence the two separate groupings.
function groupBy(sig: (vid: string) => string) {
  const map = new Map<string, string[]>();
  for (const v of m.variants) {
    const key = sig(v.id);
    const list = map.get(key) ?? [];
    list.push(v.id);
    map.set(key, list);
  }
  return [...map.values()].map((ids) => ({ ids, repId: ids[0]!, attr: ids.join(' ') }));
}
const metricsGroups = groupBy((vid) => JSON.stringify(detail.metrics[vid]));
const coverageGroups = groupBy((vid) =>
  JSON.stringify([
    detail.coverage[vid],
    detail.unicodeBlocks[vid],
    detail.missingChars[vid] ?? {},
    detail.overview[vid],
    detail.cjkCoverage[vid],
  ]),
);
---

<Base
  lang={lang}
  title={`${displayName} · ${s.siteName}`}
  description={displayDesc || `${displayName} — ${s.siteTagline}`}
  path={`/fonts/${slug}/`}
  ogImage={withBase(`/data/og/${slug}.png`)}
  entityName={displayName}
  licenseUrl={spdxUrl(m.license.spdx)}
>
  {/* The frame a catalogue card grows into when it opens this page (styles/transitions.css). */}
  <div class="vt-stage" aria-hidden="true"></div>
  <header class="hero">
    <div class="hero__heading">
      <h1 id="font-name">{displayName}</h1>
      <a class="hero__download icon-control" href="#downloads" title={s.detail.jumpToDownloads}>{s.detail.jumpToDownloads}<Icon name="arrow-down" /></a>
    </div>
    {displayName !== m.name && <p class="hero__latin mono">{m.name}</p>}
    {displayDesc && <p class="hero__desc">{displayDesc}</p>}
    <div class="hero__preview lattice" role="img" aria-label={`${displayName}: ${preview.text}`} data-variant-id={preview.variantId} set:html={previewSvg.replace('role="img"', 'aria-hidden="true"')} />
  </header>

  {
    m.variants.length > 1 && (
      <section id="sizes" class="metrics sizes">
        <details data-testid="sizes-details">
          <summary>
            <h2>{s.detail.sizesOverview}</h2>
          </summary>
          <div class="sizes__scroll">
          <table class="metrics__table mono" data-testid="sizes-overview">
            <thead>
              <tr>
                <th>{s.detail.variants}</th>
                {hasDisplaySize && <th>{s.detail.displaySize}</th>}
                <th>{s.detail.claimedSize}</th>
                <th>{s.detail.hanInk}</th>
                <th>{s.detail.maxInk}</th>
              </tr>
            </thead>
            <tbody>
              {sizeRows.map((r) => (
                <tr>
                  <td>{r.id}</td>
                  {hasDisplaySize && (
                    <td>{r.displaySize > 0 ? `${r.displaySize}${s.card.px}` : '—'}</td>
                  )}
                  <td>
                    {r.size}
                    {s.card.px}
                  </td>
                  <td>{r.hanInk}</td>
                  <td>{r.maxInk}</td>
                </tr>
              ))}
            </tbody>
          </table>
          </div>
        </details>
      </section>
    )
  }

  <div class="layout">
    <div class="layout__main">
      <SampleEditor
        client:load
        slug={slug}
        sampleText={preview.text}
        previewVariant={preview.variantId}
        variants={m.variants.map((v) => ({
          id: v.id,
          size: v.size,
          weight: v.weight,
          spacing: v.spacing,
          width: v.width,
          script: v.script,
        }))}
        s={s}
        dataBase={withBase('/data')}
        sampleLang={preview.sampleLang}
      />
      <p class="compare-link">
        <a href={withBase(`/${lang}/compare/?v=${slug}:${preview.variantId}`)}
          >{s.compare.withOthers} →</a
        >
      </p>

      <section id="metrics" class="metrics">
        <h2>{s.detail.metricsTitle}</h2>
        {
          metricsGroups.map((g) => {
            const mm = detail.metrics[g.repId]!;
            return (
              <div data-variant-panel={g.attr} hidden={!g.ids.includes(preview.variantId)}>
                <div class="metrics__flex">
                  <table class="metrics__table mono" data-testid="metrics-table">
                    <tbody>
                      <tr>
                        <th>{s.detail.claimedSize}</th>
                        <td>
                          {mm.pixelSize}
                          {s.card.px}
                        </td>
                      </tr>
                      {/* If upstream provides a recommended display size, list it alongside:
                          it measures ink height + line gap, not the same thing as the font's
                          declared em, so we show both to the reader */}
                      {(() => {
                        const dv = m.variants.find((v) => v.id === g.repId);
                        return dv && dv.displaySize > 0 ? (
                          <tr>
                            <th>{s.detail.displaySize}</th>
                            <td>
                              {dv.displaySize}
                              {s.card.px}
                            </td>
                          </tr>
                        ) : null;
                      })()}
                      <tr>
                        <th>{s.detail.hanInk}</th>
                        <td>
                          {mm.hanInk ? `${mm.hanInk[0]}×${mm.hanInk[1]}` : s.detail.hanInkNone}
                        </td>
                      </tr>
                      {mm.capHeight != null && (
                        <tr>
                          <th>{s.detail.capHeight}</th>
                          <td>{mm.capHeight}</td>
                        </tr>
                      )}
                      {mm.xHeight != null && (
                        <tr>
                          <th>{s.detail.xHeight}</th>
                          <td>{mm.xHeight}</td>
                        </tr>
                      )}
                      <tr>
                        <th>{s.detail.maxInk}</th>
                        <td title={s.detail.maxInkNote}>
                          {mm.maxInk[0]}×{mm.maxInk[1]}
                        </td>
                      </tr>
                      <tr>
                        <th>{s.detail.ascentDescent}</th>
                        <td>
                          {mm.ascent} / {mm.descent}
                        </td>
                      </tr>
                      <tr>
                        <th>{s.detail.bbox}</th>
                        <td>{mm.bbox.join(', ')}</td>
                      </tr>
                      <tr>
                        <th>{s.catalogue.spacing}</th>
                        <td>{mm.monospaced ? s.detail.monospaced : s.detail.proportional}</td>
                      </tr>
                      <tr>
                        <th>{s.detail.dwidthHist}</th>
                        <td>
                          {Object.entries(mm.dwidthHistogram)
                            .map(([w, n]) => `${w}px×${n}`)
                            .join('  ')}
                        </td>
                      </tr>
                    </tbody>
                  </table>
                  <InkDiagram
                    lang={lang}
                    pixelSize={mm.pixelSize}
                    hanInk={mm.hanInk as [number, number] | null}
                    maxInk={mm.maxInk as [number, number]}
                  />
                </div>
              </div>
            );
          })
        }
      </section>

      <CoverageReport
        initialVariant={preview.variantId}
        lang={lang}
        detail={detail}
        sections={charsetsMeta.sections}
        charsets={charsetsMeta.charsets}
        groups={coverageGroups}
        variants={m.variants.map((v) => ({
    id: v.id,
    label: `${v.size}px · ${s.weightNames[v.weight] ?? v.weight} · ${
      s.spacingNames[v.spacing] ?? v.spacing
    }${v.script ? ` · ${v.script}` : ''}`,
  }))}
/>

      <GlyphGrid
        client:visible
        slug={slug}
        variantIds={variantIds}
        initialVariant={preview.variantId}
        blocksByVariant={blocksByVariant}
        s={s}
        dataBase={withBase('/data')}
      />

      <DownloadList lang={lang} detail={detail} base={dlBase} />
    </div>

    <MetaSidebar lang={lang} detail={detail} licenseText={licenseText} />
  </div>

  <script is:inline define:vars={{ variantIds }}>
    document.addEventListener('opf:variantchange', (e) => {
      const id = e.detail?.id;
      if (!id || !variantIds.includes(id)) return;
      document.querySelectorAll('[data-variant-panel]').forEach((el) => {
        const ids = (el.getAttribute('data-variant-panel') || '').split(' ');
        el.toggleAttribute('hidden', !ids.includes(id));
      });
    });
  </script>

  <style>
  .compare-link {
    margin: var(--s2) 0 var(--s5);
    font-size: 0.85rem;
  }

    /* Shared with the catalogue card that opened this page; see lib/viewtransition.ts.
       Off during the theme reveal, which has to move the whole page as one image. */
    .vt-stage {
      /* Empty and transparent: invisible and inert, but still captured. */
      position: fixed;
      inset: 0;
      pointer-events: none;
    }
    :global(:root:not(.theme-vt)) .vt-stage {
      view-transition-name: font-card;
    }
    :global(:root:not(.theme-vt)) .hero h1 {
      view-transition-name: font-name;
    }
    :global(:root:not(.theme-vt)) .hero__preview {
      view-transition-name: font-preview;
    }
    .hero__heading {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--s2) var(--s4);
    }
    .hero__download {
      flex: 0 0 auto;
      margin-inline-start: auto;
      text-align: right;
      font-size: 0.85rem;
      color: var(--ink-2);
    }
    .hero__download:hover,
    .hero__download:focus-visible {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: .2em;
    }
    .hero h1 {
      margin: 0;
      font-size: 1.8rem;
    }
    .hero__latin {
      color: var(--ink-3);
      margin: var(--s1) 0 0;
      font-size: 0.85rem;
    }
    .hero__desc {
      color: var(--ink-2);
      margin: var(--s2) 0 0;
    }
    .hero__preview {
      margin: var(--s4) 0 var(--s5);
      border: 1px solid var(--line-soft);
      padding: var(--s4);
      max-width: 44rem;
    }
    .hero__preview :global(svg) {
      width: 100%;
      max-width: 40rem;
      height: auto;
      color: var(--ink);
    }
    .layout {
      display: grid;
      grid-template-columns: 1fr 17rem;
      gap: var(--s6);
      align-items: start;
    }
    /* grid items default to min-width:auto and get stretched by their widest child,
       causing the whole page to scroll horizontally on narrow screens */
    .layout__main {
      min-width: 0;
    }
    .layout__main > :global(section) {
      margin-bottom: var(--s6);
    }
    .metrics h2 {
      font-size: 1rem;
      margin: 0 0 var(--s3);
    }
    .metrics__flex {
      display: flex;
      gap: var(--s6);
      flex-wrap: wrap;
      align-items: flex-start;
      /* On narrow screens flex children must be allowed to shrink to 0, otherwise the
         table and diagram each stretch the whole page */
      min-width: 0;
    }
    .metrics__flex > * {
      min-width: 0;
      max-width: 100%;
    }
    /* When the metrics table doesn't fit on very narrow screens (300px), it scrolls
       horizontally on its own instead of stretching the page */
    .metrics__table {
      display: block;
      overflow-x: auto;
      max-width: 100%;
    }
    .metrics__table {
      font-size: 0.82rem;
      border-collapse: collapse;
    }
    .metrics__table th {
      text-align: left;
      color: var(--ink-3);
      font-weight: 400;
      padding: var(--s1) var(--s4) var(--s1) 0;
      font-family: var(--font-ui);
    }
    .metrics__table td {
      padding: var(--s1) 0;
    }
    /* Sizes overview: right-align data columns with spacing; scrolls horizontally on
       narrow screens instead of widening the page */
    .sizes {
      margin-bottom: var(--s6);
    }
    /* Collapsible heading: the native marker doesn't align to the baseline of a large h2,
       so we hide it and draw our own with flex — same approach as the language menu */
    .sizes summary {
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: var(--s2);
      list-style: none;
    }
    .sizes summary::-webkit-details-marker {
      display: none;
    }
    .sizes summary::before {
      content: '▸';
      /* Pure black (inverts with body color under dark theme); no gray dimming */
      color: var(--ink);
      transition: transform 0.15s;
    }
    .sizes details[open] > summary::before {
      transform: rotate(90deg);
    }
    .sizes summary h2 {
      margin: 0;
    }
    .sizes__scroll {
      overflow-x: auto;
      /* overflow alone isn't enough: without a width constraint on this container,
         the table still stretches it, which then blows out the whole page.
         max-width sets a ceiling so the scroll actually happens inside the container */
      max-width: 100%;
    }
    /* Scrolling for the sizes table is handled by the outer .sizes__scroll; the table
       itself keeps table layout. width:max-content lets it expand naturally to fit its
       content, with any overflow absorbed by the container's scroll */
    .sizes .metrics__table {
      display: table;
      overflow-x: visible;
      width: max-content;
      max-width: none;
    }
    .sizes .metrics__table td {
      padding-right: var(--s4);
      white-space: nowrap;
    }
    .sizes thead th {
      border-bottom: 1px solid var(--line);
    }
    @media (max-width: 900px) {
      .layout {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Base>
