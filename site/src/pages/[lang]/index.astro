---
import { licenseShortLabel } from '../../lib/licenselabel';
import Base from '../../layouts/Base.astro';
import Catalogue from '../../islands/Catalogue.svelte';
import { LANGS, pickName, pickText, t, type Lang } from '../../i18n';
import { loadIndex, readPreviewSvg, withBase } from '../../lib/data';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const s = t(lang);
const index = loadIndex();
const families = index.families;
// Control initial HTML payload: only the first 12 cards get inlined pre-rendered SVG,
// the rest of the static cards keep only text
const previews = new Map(
  families.slice(0, 12).map((f) => {
    try {
      return [f.slug, readPreviewSvg(f.preview)] as const;
    } catch {
      return [f.slug, ''] as const;
    }
  }),
);
---

<Base
  lang={lang}
  title={s.siteName}
  description={s.siteTagline}
  path="/"
>
  <p class="tagline">{s.siteTagline}</p>

  <Catalogue
    client:load
    families={families}
    lang={lang}
    s={s}
    dataBase={withBase('/data')}
    fontsBase={withBase(`/${lang}/fonts/`)}
    charsetIds={index.charsetIds}
    charsetNames={index.charsetNames}
  />

  <!-- No-JS initial paint & SEO: removed once the island hydrates -->
  <section class="ssr" data-ssr-grid data-testid="catalogue">
    <div class="grid">
      {
        families.map((f) => (
          <article class="card" data-slug={f.slug}>
            <a href={withBase(`/${lang}/fonts/${f.slug}/`)} class="card__link">
              <h2 class="card__name">
                {pickName(lang, f.names, f.name)}
              </h2>
              <div class="card__preview" set:html={previews.get(f.slug)} />
              <p class="card__meta">
                {f.sizes.map((sz) => (
                  <span class="chip mono">
                    {sz}
                    {s.card.px}
                  </span>
                ))}
                {f.form && <span class="chip">{s.forms[f.form] ?? f.form}</span>}
                {f.license.spdx && (
                  <span class="chip">{licenseShortLabel(f.license.spdx)}</span>
                )}
                <span class="chip mono">
                  {f.glyphCount.toLocaleString()} {s.card.glyphs}
                </span>
              </p>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <style>
    .tagline {
      color: var(--ink-2);
      margin: 0 0 var(--s5);
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
      gap: var(--s4);
    }
    .card {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface);
    }
    .card__link {
      display: block;
      padding: var(--s4);
    }
    .card__name {
      font-size: 1rem;
      margin: 0 0 var(--s3);
    }
    .card__preview :global(svg) {
      width: 100%;
      height: auto;
      max-height: 5.5rem;
      color: var(--ink);
    }
    .card__meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s1);
      margin: var(--s3) 0 0;
    }
  </style>
</Base>
