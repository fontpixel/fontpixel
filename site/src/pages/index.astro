---
// 语言跳转页：按浏览器语言去 /zh/ 或 /en/，默认 zh。
import { withBase } from '../lib/data';
const zhUrl = withBase('/zh/');
const enUrl = withBase('/en/');
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>免费开源位图（像素）字体 Free & Open Source Bitmap (Pixel) Fonts</title>
    <link rel="alternate" hreflang="zh-Hans" href={zhUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={zhUrl} />
    <meta name="robots" content="noindex" />
    <script is:inline define:vars={{ zhUrl, enUrl }}>
      var lang = (navigator.language || 'zh').toLowerCase();
      location.replace(lang.indexOf('zh') === 0 ? zhUrl : enUrl);
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${zhUrl}`} /></noscript>
  </head>
  <body>
    <p><a href={zhUrl}>中文</a> · <a href={enUrl}>English</a></p>
  </body>
</html>
