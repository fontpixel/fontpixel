---
import '../styles/tokens.css';
import SeoHead from '../components/SeoHead.astro';
import { withBase } from '../lib/data';
import sitenames from '../i18n/sitenames.json';

// 5×7 pixel digits, hand-drawn bitmap — a 404 page should obviously use a bitmap
const DIGITS: Record<string, string[]> = {
  '4': ['00010', '00110', '01010', '10010', '11111', '00010', '00010'],
  '0': ['01110', '10001', '10011', '10101', '11001', '10001', '01110'],
};
const text = '404';
const gap = 2;
const cells: { x: number; y: number }[] = [];
let ox = 0;
for (const ch of text) {
  const rows = DIGITS[ch]!;
  rows.forEach((row, y) => {
    [...row].forEach((bit, x) => {
      if (bit === '1') cells.push({ x: ox + x, y });
    });
  });
  ox += 5 + gap;
}
const w = ox - gap;
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead lang="zh" title={`404 · ${sitenames.zh} / ${sitenames.en}`} description="页面不存在。Page not found. Browse the FontPixel open-source pixel font collection." path="/404/" canonicalPath="/404" availableLangs={[]} noindex />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="16x16" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('opf-theme');
          document.documentElement.dataset.theme =
            t || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          var p = localStorage.getItem('opf-palette');
          if (p) document.documentElement.dataset.palette = p;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <main class="container nf">
      <h1 class="visually-hidden">404 — 页面不存在 / Page not found</h1>
      <svg
        data-testid="pixel-404"
        viewBox={`0 0 ${w} 7`}
        width={w * 14}
        height={7 * 14}
        shape-rendering="crispEdges"
        role="img"
        aria-label="404"
      >
        {cells.map((c) => <rect x={c.x} y={c.y} width="1" height="1" fill="var(--accent)" />)}
      </svg>
      <p class="nf__text">页面不存在，这个码位还没有字形。</p>
      <p class="nf__text nf__text--en" lang="en">Page not found — no glyph at this code point.</p>
      <p class="nf__links">
        <a href={withBase('/zh/')}>回到馆藏</a> · <a href={withBase('/en/')}>Catalogue</a>
      </p>
    </main>
    <style>
      .nf {
        padding-top: 14vh;
        text-align: center;
      }
      .nf svg {
        max-width: 70vw;
        height: auto;
      }
      .nf__text {
        color: var(--ink-2);
        margin: var(--s5) 0 0;
      }
      .nf__text--en {
        color: var(--ink-3);
        font-size: 0.85rem;
        margin-top: var(--s1);
      }
      .nf__links {
        margin-top: var(--s4);
      }
      .nf__links a {
        color: var(--accent);
      }
    </style>
  </body>
</html>
